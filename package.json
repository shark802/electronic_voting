{
	"name": "BCC-web-based-e-voting",
	"version": "1.0.0",
	"description": "Capstone Project about online voting with face recognition",
	"main": "dist/app.js",
	"scripts": {
		"build-css": "tailwindcss -i ./public/css/input.css -o ./public/css/style.css",
		"build": "tsc",
		"start": "cross-env NODE_ENV=production node ./dist/app.js",
		"build-css:dev": "tailwindcss -i ./public/css/input.css -o ./public/css/style.css -w",
		"build:dev": "cross-env NODE_ENV=development tsc -w -p tsconfig.dev.json",
		"dev": " cross-env NODE_ENV=development nodemon ./dist/app.js"
	},
	"author": "John Lester Villarde",
	"license": "ISC",
	"dependencies": {
		"bcryptjs": "^2.4.3",
		"dotenv": "^16.4.5",
		"ejs": "^3.1.10",
		"express": "^4.19.2",
		"express-mysql-session": "^3.0.3",
		"express-session": "^1.18.0",
		"mysql2": "^3.9.7",
		"socket.io": "^4.7.5",
		"ulid": "^2.3.0"
	},
	"devDependencies": {
		"@types/bcryptjs": "^2.4.6",
		"@types/express": "^4.17.21",
		"@types/express-mysql-session": "^3.0.6",
		"@types/express-session": "^1.18.0",
		"@types/node": "^20.11.30",
		"cross-env": "^7.0.3",
		"nodemon": "^3.1.0",
		"tailwindcss": "^3.4.3",
		"typescript": "^5.4.3"
	}
}
