<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Landing Page</title>

  <link rel="stylesheet" href="/css/style.css">
  <script src="/javascript/lib/sweetalert2@11.js"></script>
  <script type="module" src="/javascript/landing-page.js" defer></script>
  <style>
    main {
      background-image: url('/img/image.png');
    }

    dialog::backdrop {
      background-color: rgba(0, 0, 0, 0.3);
    }
  </style>
</head>

<body class="w-full font-bold bg-blue-700 h-dvh scroll-m-0 lg:overflow-hidden lg:h-screen">
  <header class="sticky flex items-center justify-center w-full h-24 bg-blue-800">
    <h1 class="lg:text-lg text-sm max-w-[70%] float-right xl:max-w-[40%] flex justify-center lg:m-auto text-center text-blue-400">BCC
      WEB-BASED E-VOTING WITH FACIAL RECOGNITION AUTHENTICATOR</h1>
  </header>

  <main class="flex bg-no-repeat bg-cover bg-center text-white flex-col h-[85%] lg:h-[74%] place-items-center">

    <div class="flex justify-end w-full mt-2 mr-1 lg:gap-2 lg:pr-8 justify-self-start">
      <% if (user) { %>
      <a href="/election"><button class="text-xs font-bold text-blue-500 bg-white button focus:outline-none">Election</button></a>
      <% } else { %>
      <button id="login-button" class="text-xs font-bold text-blue-500 bg-white button focus:outline-none">Login</button>
      <% } %>
      <button id="register-device-button" class="text-xs font-semibold button">Register Device</button>
    </div>

    <div class="absolute center lg:w-[50%] w-[90%]">
      <p class="m-auto font-sans text-2xl text-center lg:text-5xl pb-11">Welcome
        to Bago City College Online Voting System</p>
      <p class="max-w-[80%] lg:max-w-[50% ] text-wrap text-center text-lg lg:text-2xl font-normal text-white m-auto font-sans">Welcome
        to official online voting platform of Bago City College.
        Our secure and easy to use system allows you to participate in school
        elections and make your voice heard.</p>
    </div>

  </main>

  <footer class="flex flex-col w-full p-5 pb-12 text-xs text-white bg-blue-800 max-h-fit lg:bottom-0 lg:fixed lg:flex-row lg:justify-evenly lg:pb-8">

    <div class="lg:text-center">
      <p>Contact Us</p>
      <p class="font-medium">ahahah </p>
    </div>

    <div class="lg:text-center">
      <p>Location</p>
      <p class="font-medium">ahahah haha</p>
    </div>

    <div class="lg:text-center">
      <p>Like us on Facebook</p>
      <p class="font-medium">ahahah </p>
    </div>

  </footer>


  <!-- Login Modal -->
  <dialog id="login-modal" class="w-full px-2 pt-8 rounded-md shadow-lg lg:w-[400px] lg:px-7">

    <img src="/img/x.webp" id="login-modal-exit" alt="exit" class="absolute rounded-full w-7 top-3 right-3 opacity-70 hover:bg-blue-200">
    <img src="/img/bcc-logo.webp" alt="BCC Logo" class="w-1/3 m-auto">
    <form id="login-form" class="grid px-2 pb-10 rounded-md">
      <div class="grid">
        <label for="school-id" class="block mb-1 text-sm font-medium text-gray-900">Username</label class="font-semibold">
        <input type="text" id="school-id" placeholder="your id number" class="py-1 pl-3 font-normal border border-gray-400 rounded-md focus:outline-blue-500">

        <div id="schoolIdErrorMessage" class="text-xs font-normal text-red-500 min-h-5"></div>
      </div>

      <div class="grid">
        <label for="password" class="block mb-1 text-sm font-medium text-gray-900">Password</label class="font-semibold ">
        <input type="password" id="password" placeholder="••••••••" class="py-1 pl-3 font-normal border border-gray-400 rounded-md focus:outline-blue-500">
        <div id="passwordErrorMessage" class="text-xs font-normal text-red-500 min-h-5"></div>
      </div>

      <!-- <input type="submit" value="LOGIN" class="py-2 mt-4 font-semibold text-center text-white bg-blue-500 rounded-lg"> -->
      <button type="submit" class="w-full mt-3 text-white bg-blue-700 hover:bg-blue-800 focus:ring-4 focus:outline-none focus:ring-blue-300 font-medium rounded-lg text-sm px-5 py-2.5 text-center dark:bg-blue-500 dark:hover:bg-blue-600 dark:focus:ring-blue-800">Login to your account</button>


    </form>
  </dialog>

  <!-- Register device Modal -->
  <dialog id="registerDeviceModal" class="w-full px-5 pt-10 rounded-md shadow-lg lg:w-[400px] lg:px-7">
    <img src="/img/x.webp" id="closeRegisterDevice" alt="close" class="absolute rounded-full w-7 hover:bg-gray-300 opacity-70 top-3 right-3">
    <h2 class="text-lg text-center text-gray-600">Register Device</h2>
    <form id="registerDeviceForm" class="py-7">

      <div class="flex flex-col mt-3">
        <label for="code-name" class="font-medium text-gray-800">Code name *</label>
        <input type="text" id="code-name" class="py-1 pl-3 font-normal border border-gray-400 rounded-md focus:outline-blue-500">
        <div id="codeNameErrorMessage" class="text-sm font-normal text-red-500 min-h-5"></div>
      </div>

      <input type="submit" value="Generate UUID" class="w-full py-2 mt-6 text-center text-white bg-green-500 rounded-md">

    </form>
  </dialog>

</body>

</html>