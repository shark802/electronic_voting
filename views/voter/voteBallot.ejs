<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Vote Ballot</title>

  <link rel="stylesheet" href="/css/style.css">
  <script src="/javascript/lib/sweetalert2@11.js"></script>
  <script type="module" src="/javascript/voter/voteBallot.js"></script>

  <style>
    dialog::backdrop {
      background-color: rgba(0, 0, 0, 0.4);
    }
  </style>
</head>

<body class="w-full px-3 overflow-hidden overflow-y-auto bg-blue-600 lg:px-0 h-dvh">

  <a href="/election">
    <header class="flex items-center gap-3 pl-6 min-h-20">
      <img src="/img/back.webp" alt="back" class="w-6 aspect-square">
      <p class="text-white">Back to Home</p>
    </header>
  </a>

  <div class="pb-32 mt-11">

    <form id="ballot-form" class="m-auto align-middle py-5 px-3 bg-white rounded-lg lg:p-3 h-fit max-w-[700px] min-h-4/5">
      <div class="py-2">
        <h1 class="text-2xl font-bold text-center text-gray-600"><%= election ? election.election_name : "Official Ballot" %></h1>
      </div>

      <% 
    if (candidatePositionList && candidatePositionList.length > 0) {
      
      if(candidateList.length <= 0) {
    %>
      <div class="px-3 py-6 mt-6 text-lg font-semibold text-center text-blue-700 bg-blue-200 rounded-lg">
        <p>No Candidates to display on this election</p>
      </div>
      <%
      }
      candidatePositionList.forEach(position => {

        let candidatePerPosition;
        if (position === 'SENATOR') {
          candidatePerPosition = candidateList.filter(candidate => {
            return candidate.position === position && candidate.course === user.course;
          });
        } else {
          candidatePerPosition = candidateList.filter(candidate => {
            return candidate.position === position;
          });
        }
    %>

      <% if (candidatePerPosition.length > 0) { %>
      <section class="my-3 border-2 rounded-md shadow-gray-400 lg:mb-7">

        <div id="position-label" class="w-full py-1 mb-3 font-bold text-center text-white bg-blue-500 rounded-tl-md rounded-tr-md"> <%= position %> </div>
        <div>
          <% candidatePerPosition.forEach(candidateOfPosition => { %>
          <div class="flex items-center gap-2 py-1 pl-2 lg:px-7">

            <% if (candidateOfPosition.candidate_profile) { %>
            <img src="/img/candidate_profiles/<%=candidateOfPosition.candidate_profile%>" alt="candidate-profile" class="lg:w-24">
            <% } else {%>
            <img src="/img/default-profile.webp" alt="candidate-profile" class="lg:w-24">

            <% } %>
            <span>
              <input name="<%= position %>" type="radio" value="<%= candidateOfPosition.id_number%>" id="<%= candidateOfPosition.alias %><%= candidateOfPosition.id_number %>" class="w-5 h-5 text-blue-600 bg-gray-100 border-gray-300 rounded-full focus:ring-blue-500 dark:focus:ring-blue-600">
              <label for="<%= candidateOfPosition.id_number %>" class="relative text-sm lg:text-base font-bold text-gray-500 -top-[3px]"> <%= candidateOfPosition.firstname %> <%= candidateOfPosition.lastname %> - <span class="text-sm font-normal text-gray-400"> <%= candidateOfPosition.party %> </span> </label>
            </span>
          </div>
          <% }) %>
        </div>

      </section>

      <%
        }
      });
    }

    if (candidateList.length > 0) {
    %>

      <div class="relative flex justify-end gap-3">
        <button type="reset" class="px-2 py-1 text-sm font-semibold text-gray-400 transition-all bg-gray-200 rounded-md hover:bg-gray-300 hover:text-gray-500">Reset</button>
        <button class="px-6 py-1 font-semibold text-white transition-all bg-green-500 rounded-md hover:ring-2 ring-green-300" type="submit">Save Vote</button>
      </div>


      <%
  }
    %>

    </form>

  </div>

</body>

</html>