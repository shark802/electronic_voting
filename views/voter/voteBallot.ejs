<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Vote Ballot</title>

  <link rel="stylesheet" href="/css/style.css">
  <script src="/javascript/lib/sweetalert2@11.js"></script>
  <script type="module" src="/javascript/voter/voteBallot.js"></script>

  <style>
    dialog::backdrop {
      background-color: rgba(0, 0, 0, 0.4);
    }

    .custom-checkbox {
      -webkit-appearance: none;
      -moz-appearance: none;
      appearance: none;
      display: inline-block;
      position: relative;
      background-color: #f1f1f1;
      border: 2px solid #cacece;
      border-radius: 50%;
      cursor: pointer;
    }

    .custom-checkbox:checked {
      background-color: #f1f1f1;
      border-color: #3b82f6;
    }

    .custom-checkbox:checked::after {
      content: '';
      position: absolute;
      left: 50%;
      top: 50%;
      transform: translate(-50%, -50%);
      width: 10px;
      height: 10px;
      border-radius: 50%;
      background-color: #2c74e8;
    }
  </style>
</head>

<body class="w-full overflow-hidden overflow-y-auto lg:px-0 h-dvh">

  <header class="flex items-center justify-between w-full px-4 py-3 shadow-md bg-gradient-to-r from-blue-800 to-blue-600">
    <a href="/election" class="flex items-center gap-2 px-3 py-2 text-white transition-colors duration-200 bg-blue-600 rounded-full shadow-md hover:text-blue-200 hover:bg-blue-700">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
      </svg>
      <span class="text-sm font-medium">Back</span>
    </a>
  </header>

  <div class="px-3 pb-32 mt-11">

    <form id="ballot-form" class="m-auto align-middle py-5 px-3 bg-white rounded-lg lg:p-6 h-fit max-w-[800px] min-h-4/5 shadow-lg">
      <div class="py-2 mb-6">
        <h1 class="text-3xl font-bold text-center text-gray-800"><%= election ? election.election_name : "Official Ballot" %></h1>
        <p class="mt-2 text-center text-gray-600">Please select one candidate for each position</p>
      </div>

      <% 
    if (candidatePositionList && candidatePositionList.length > 0) {
      
      if(candidateList.length <= 0) {
    %>
      <div class="px-3 py-6 mt-6 text-lg font-semibold text-center text-blue-700 bg-blue-100 border border-blue-300 rounded-lg">
        <p>No candidates to display for this election</p>
      </div>
      <%
      }
      candidatePositionList.forEach(position => {

        let candidatePerPosition;
        if (position === 'SENATOR') {
          candidatePerPosition = candidateList.filter(candidate => {
            return candidate.position === position && candidate.course === user.course;
          });
        } else {
          candidatePerPosition = candidateList.filter(candidate => {
            return candidate.position === position;
          });
        }
    %>

      <% if (candidatePerPosition.length > 0) { %>
      <section class="my-3 transition-shadow duration-300 border-2 rounded-md shadow-md lg:mb-7 hover:shadow-lg" <%= position === 'SENATOR' ? `data-max-vote="${departmentMaxSenatorVote[user.course]}"` : '' %>>

        <div id="position-label" class="w-full py-2 mb-3 text-lg font-bold text-center text-white bg-blue-600 rounded-tl-md rounded-tr-md"> <%= position %> </div>
        <div class="p-4">
          <% candidatePerPosition.forEach(candidateOfPosition => { %>
          <div class="flex items-center gap-4 py-3 pl-2 transition-colors duration-200 rounded-md lg:px-7 hover:bg-gray-50">
            <% if (candidateOfPosition.candidate_profile) { %>
            <img src="/img/candidate_profiles/<%=candidateOfPosition.candidate_profile%>" alt="candidate-profile" class="object-cover w-16 h-16 rounded-full lg:w-24 lg:h-24">
            <% } else {%>
            <img src="/img/default-profile.webp" alt="candidate-profile" class="object-cover w-16 h-16 rounded-full lg:w-24 lg:h-24">
            <% } %>
            <div class="flex-grow">
              <label for="<%= candidateOfPosition.id_number %>" class="flex items-center cursor-pointer">

                <% if (position === 'SENATOR') { %>
                <input name="<%= position %>" type="checkbox" value="<%= candidateOfPosition.id_number%>" id="<%= candidateOfPosition.alias %><%= candidateOfPosition.id_number %>" class="w-5 h-5 mr-3 custom-checkbox">
                <% } else { %>
                <input name="<%= position %>" type="radio" value="<%= candidateOfPosition.id_number%>" id="<%= candidateOfPosition.alias %><%= candidateOfPosition.id_number %>" class="w-5 h-5 mr-3 text-blue-600 bg-gray-100 border-gray-300 rounded-full focus:ring-blue-500 dark:focus:ring-blue-600">
                <% } %>

                <div>
                  <span class="text-base font-bold text-gray-700 lg:text-lg"><%= candidateOfPosition.firstname %> <%= candidateOfPosition.lastname %></span>
                  <span class="block text-sm font-normal text-gray-500"><%= candidateOfPosition.party %></span>
                </div>
              </label>
            </div>
          </div>
          <% }) %>
        </div>

      </section>

      <%
        }
      });
    }

    if (candidateList.length > 0) {
    %>

      <div class="relative flex justify-end gap-3 mt-8">
        <button type="reset" class="px-4 py-2 text-sm font-semibold text-gray-600 transition-all bg-gray-200 rounded-md hover:bg-gray-300 hover:text-gray-700 focus:outline-none focus:ring-2 focus:ring-gray-400">Reset</button>
        <button class="px-6 py-2 font-semibold text-white transition-all bg-green-500 rounded-md hover:bg-green-600 focus:outline-none focus:ring-2 focus:ring-green-400" type="submit">Submit Ballot</button>
      </div>


      <%
  }
    %>

    </form>

  </div>

</body>

</html>