<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Vote Ballot</title>

  <link rel="stylesheet" href="/css/style.css">
</head>

<body class="w-full pt-24 overflow-hidden overflow-y-auto bg-blue-600 mb-44 h-dvh">

  <form class="m-auto align-middle py-5 px-3 bg-white rounded-lg lg:p-3 h-fit max-w-[700px] min-h-4/5">

    <h1 class="text-2xl font-bold text-center"><%= election ? election.election_name : "Official Ballot" %></h1>

    <% 
    if (candidatePositionList && candidatePositionList.length > 0) {
      
      if(candidateList.length <= 0) {
    %>
    <div class="px-3 py-6 mt-6 text-lg font-semibold text-center text-blue-700 bg-blue-200 rounded-lg">
      <p>No Candidates to display on this election</p>
    </div>
    <%
      }
      candidatePositionList.forEach(position => {

        let candidatePerPosition;
        if (position === 'SENATOR') {
          candidatePerPosition = candidateList.filter(candidate => {
            return candidate.position === position && candidate.course === user.course;
          });
        } else {
          candidatePerPosition = candidateList.filter(candidate => {
            return candidate.position === position;
          });
        }
    %>

    <% if (candidatePerPosition.length > 0) { %>
    <section class="my-3 border-2 rounded-md shadow-gray-400 lg:mb-7">

      <div class="w-full py-1 mb-3 font-bold text-center text-white bg-blue-500 rounded-tl-md rounded-tr-md"> <%= position %> </div>
      <div>
        <% candidatePerPosition.forEach(candidateOfPosition => { %>
        <div class="flex justify-between py-1 lg:px-7">
          <label for="<%= candidateOfPosition.alias %><%= candidateOfPosition.id_number %>" class="text-sm font-semibold text-gray-600"> <%= candidateOfPosition.firstname %> <%= candidateOfPosition.lastname %> </label>
          <input name="<%= position %>" type="radio" id="<%= candidateOfPosition.alias %><%= candidateOfPosition.id_number %>" class="w-4">
        </div>
        <% }) %>
      </div>

    </section>

    <%
        }
      });
    }

    if (candidateList.length > 0) {
    %>

    <div class="relative flex flex-row-reverse">
      <button class="px-6 py-1 font-semibold text-white bg-green-500 rounded-md" type="submit">Save Vote</button>
    </div>

    <%
  }
    %>

  </form>
</body>

</html>