<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Vote Ballot</title>

  <link rel="stylesheet" href="/css/style.css">
  <script src="/javascript/lib/sweetalert2@11.js"></script>
  <script src="/javascript/lib/socket.io.min.js" defer></script>
  <script type="module" src="/javascript/voter/voteBallot.js"></script>

  <style>
    dialog::backdrop {
      background-color: rgba(0, 0, 0, 0.4);
    }

    .custom-checkbox {
      -webkit-appearance: none;
      -moz-appearance: none;
      appearance: none;
      display: inline-block;
      position: relative;
      background-color: #ffffff;
      border: 1px solid #5c5c5c;
      border-radius: 50%;
      cursor: pointer;
    }

    .custom-checkbox:checked {
      background-color: #ffffff;
      border-color: #005CC8;
    }

    .custom-checkbox:checked::after {
      content: '';
      position: absolute;
      left: 50%;
      top: 50%;
      transform: translate(-50%, -50%);
      width: 12px;
      height: 12px;
      border-radius: 50%;
      background-color: #2c74e8;
    }
  </style>
</head>

<body class="w-full overflow-hidden overflow-y-auto lg:px-0 h-dvh">

  <header class="flex items-center justify-between w-full px-4 py-3 shadow-md bg-gradient-to-r from-blue-800 to-blue-600">
    <a href="/election" class="flex items-center gap-2 px-3 py-2 text-white transition-colors duration-200 bg-blue-600 rounded-full shadow-md hover:text-blue-200 hover:bg-blue-700">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
      </svg>
      <span class="text-sm font-medium">Back</span>
    </a>
  </header>

  <div class="px-3 pb-12 mt-8 lg:pb-14 lg:mt-11">

    <form id="ballot-form" class="max-w-3xl mx-auto my-8 overflow-hidden bg-white border-2 rounded-lg shadow-lg">
      <div class="p-3 py-4 text-white lg:p-6 bg-gradient-to-r from-blue-600 to-blue-800">
        <h1 class="text-xl font-bold text-center lg:text-3xl">
          <%= election ? election.election_name : "Official Ballot" %>
        </h1>
      </div>

      <% if (candidatePositionList && candidatePositionList.length > 0) { %>
      <% if (candidateList.length <= 0) { %>
      <div class="p-6">
        <div class="p-4 text-blue-700 border-l-4 border-blue-500 rounded-md bg-blue-50" role="alert">
          <p class="font-medium">No candidates to display for this election</p>
        </div>
      </div>
      <% } else { %>
      <div class="p-6 px-2 space-y-4 lg:space-y-8 lg:px-6">
        <% candidatePositionList.forEach(position => { %>
        <% 
            let candidatePerPosition;
            if (position === 'SENATOR') {
              candidatePerPosition = candidateList.filter(candidate => 
                candidate.position === position && candidate.course === user.course
              );
            } else {
              candidatePerPosition = candidateList.filter(candidate => 
                candidate.position === position
              );
            }
          %>

        <% if (candidatePerPosition.length > 0) { %>
        <section class="overflow-hidden rounded-lg shadow-sm bg-gray-50" <%= position === 'SENATOR' ? `data-max-vote=${departmentMaxSenatorVote[user.course]}` : '' %>>
          <div class="p-2 bg-blue-600 lg:p-4">
            <h2 id="position-label" class="text-lg font-semibold text-white lg:text-xl"><%= position %></h2>
            <p class="text-sm text-blue-100 lg:mt-1">
              Please select
              <span class="font-medium">
                <%= position === 'SENATOR' ? `maximum ${departmentMaxSenatorVote[user.course]}` : 1 %>
                <%= position === 'SENATOR' ? (departmentMaxSenatorVote[user.course] > 1 ? 'candidates' : 'candidate') : 'candidate' %>
              </span>
            </p>
          </div>

          <div class="p-2 space-y-4 lg:p-4">
            <% candidatePerPosition.forEach(candidateOfPosition => { %>
            <div class="flex items-center p-3 space-x-4 transition-shadow duration-200 bg-white rounded-md shadow-sm hover:shadow-md">
              <% if (candidateOfPosition.candidate_profile) { %>
              <img src="/img/candidate_profiles/<%= candidateOfPosition.candidate_profile %>" alt="<%= candidateOfPosition.firstname %> <%= candidateOfPosition.lastname %>" class="object-cover w-16 h-16 rounded-full shadow-sm lg:w-24 lg:h-24">
              <% } else { %>
              <img src="/img/default-profile.webp" alt="Default profile" class="object-cover w-16 h-16 rounded-full shadow-sm lg:w-24 lg:h-24">
              <% } %>
              <label for="<%= candidateOfPosition.id_number %>" class="flex-grow cursor-pointer">
                <div class="flex items-center">
                  <% if (position === 'SENATOR') { %>
                  <input name="<%= position %>" type="checkbox" value="<%= candidateOfPosition.id_number %>" id="<%= candidateOfPosition.alias %><%= candidateOfPosition.id_number %>" class="w-5 h-5 text-blue-600 border-gray-300 rounded custom-checkbox focus:ring-blue-500">
                  <% } else { %>
                  <input name="<%= position %>" type="radio" value="<%= candidateOfPosition.id_number %>" id="<%= candidateOfPosition.alias %><%= candidateOfPosition.id_number %>" class="w-5 h-5 text-blue-600 border-gray-300 focus:ring-blue-500">
                  <% } %>
                  <div class="ml-3">
                    <span class="text-sm font-medium text-gray-900 lg:text-lg">
                      <%= candidateOfPosition.firstname %> <%= candidateOfPosition.lastname %>
                    </span>
                    <span class="block text-xs text-gray-500 lg:text-sm"><%= candidateOfPosition.party %></span>
                  </div>
                </div>
              </label>
            </div>
            <% }) %>
          </div>

          <div class="px-2 lg:pb-4 lg:px-4">
            <div class="text-xs text-red-500 lg:text-sm error-message min-h-6" id="error-<%= position %>"></div>
          </div>
        </section>
        <% } %>
        <% }) %>
      </div>
      <% } %>
      <% } %>

      <% if (candidateList.length > 0) { %>
      <div class="p-6 border-t border-gray-200 bg-gray-50">
        <div class="flex justify-end space-x-4">
          <button type="reset" class="px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-md shadow-sm hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">
            Reset
          </button>
          <button type="submit" class="px-4 py-2 text-sm font-medium text-white bg-blue-600 rounded-md shadow-sm hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">
            Submit Ballot
          </button>
        </div>
      </div>
      <% } %>
    </form>


  </div>

</body>

</html>