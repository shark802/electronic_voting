<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Election Results</title>
  <script src="/javascript/lib/jquery-3.7.1.min.js"></script>
  <script src="/javascript/lib/socket.io.min.js" defer></script>
  <script src="/javascript/lib/sweetalert2@11.js" defer></script>
  <script type="module" src="/javascript/voter/electionResultForVoter.js"></script>
  <link rel="stylesheet" href="/css/style.css">
  <style>
    dialog::backdrop {
      background-color: rgba(0, 0, 0, 0.4);
    }

    @keyframes fadeIn {
      from {
        opacity: 0;
        transform: translateY(10px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .animate-fade-in {
      animation: fadeIn 0.3s ease-out forwards;
    }
  </style>
</head>

<body class="min-h-screen text-blue-900 bg-blue-50">
  <!-- Compact header with sticky navigation -->
  <header class="sticky top-0 z-50 w-full shadow-md">
    <!-- Main header with gradient background -->
    <div class="bg-gradient-to-r from-blue-900 to-blue-700">
      <div class="container max-w-6xl px-4 mx-auto">
        <div class="flex items-center justify-between h-14">
          <!-- Left side with back button and election name -->
          <div class="flex items-center space-x-4">
            <a href="/election" class="inline-flex items-center px-3 py-1.5 text-sm font-medium text-white bg-blue-800 rounded-md hover:bg-blue-600 transition-colors">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
              </svg>
              <span class="hidden sm:inline">Back</span>
            </a>

            <h1 class="text-base font-semibold text-white truncate">
              <span class="hidden sm:inline">Results:</span>
              <span class="text-blue-200"><%= electionInfo.election_name %></span>
            </h1>
          </div>

          <!-- Right side with status badge only (PDF button removed) -->
          <div class="flex items-center">
            <% 
          const now = new Date();
          const startDate = new Date(electionInfo.date_start);
          startDate.setHours(parseInt(electionInfo.time_start.split(':')[0]), parseInt(electionInfo.time_start.split(':')[1]));
          
          const endDate = new Date(electionInfo.date_end);
          endDate.setHours(parseInt(electionInfo.time_end.split(':')[0]), parseInt(electionInfo.time_end.split(':')[1]));
          
          let statusClass = '';
          let statusText = '';
          
          if (now < startDate) {
            statusClass = 'bg-blue-300 text-blue-900';
            statusText = 'Upcoming';
          } else if (now > endDate) {
            statusClass = 'bg-blue-600 text-white';
            statusText = 'Completed';
          } else {
            statusClass = 'bg-blue-500 text-white';
            statusText = 'In Progress';
          }
          %>
            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium <%= statusClass %>">
              <%= statusText %>
            </span>
          </div>
        </div>
      </div>
    </div>

    <!-- Full-width election info bar -->
    <div class="w-full py-2 text-xs text-blue-200 bg-blue-800">
      <div class="container max-w-6xl px-4 mx-auto">
        <div class="flex flex-wrap items-center justify-between">
          <div class="flex items-center space-x-4">
            <div class="flex items-center">
              <svg class="w-3.5 h-3.5 mr-1 text-blue-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
              </svg>
              <span><%= formatDateTime(electionInfo.date_start, electionInfo.time_start) %> - <%= formatDateTime(electionInfo.date_end, electionInfo.time_end) %></span>
            </div>

            <div class="items-center hidden sm:flex">
              <svg class="w-3.5 h-3.5 mr-1 text-blue-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
              </svg>
              <span><%= candidatesVoteTally.length %> Candidates</span>
            </div>

            <div class="items-center hidden sm:flex">
              <svg class="w-3.5 h-3.5 mr-1 text-blue-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
              </svg>
              <span><%= positionList.length %> Positions</span>
            </div>
          </div>

          <input type="hidden" id="election-id" value="<%= electionInfo.election_id %>">
        </div>
      </div>
    </div>
  </header>

  <main class="container max-w-3xl px-4 py-6 mx-auto">
    <div id="result-box" class="w-full">
      <% if (positionList && positionList.length > 0) { %>
      <% if (candidatesVoteTally.length < 1) { %>
      <!-- No results state -->
      <div class="p-6 text-center bg-white border border-blue-100 rounded-lg shadow-sm">
        <svg class="w-12 h-12 mx-auto mb-3 text-blue-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
        </svg>
        <h2 class="text-lg font-medium text-blue-800">No Results Available</h2>
        <p class="mt-1 text-sm text-blue-600">There are no candidates or results available for this election.</p>
      </div>
      <% } else { %>
      <!-- Results by position -->
      <div class="grid gap-4 sm:gap-6">
        <% 
          positionList.forEach((position, posIndex) => {
            // Special handling for SENATOR position
            if (position === 'SENATOR') {
              // Get all senator candidates for the voter's department only
              const senatorCandidates = candidatesVoteTally.filter(candidate => 
                candidate.position === position && candidate.department_name === user.department_name
              );
              
              if (senatorCandidates.length > 0) {
          %>
        <!-- SENATOR section for voter's department only -->
        <section class="overflow-hidden bg-white border border-blue-200 rounded-lg shadow-sm animate-fade-in" style="animation-delay: <%= (posIndex * 0.05).toFixed(2) %>s">
          <div class="py-2 text-center text-white bg-blue-600">
            <h3 class="text-base font-medium">SENATOR - <%= user.department_name %> Department</h3>
          </div>

          <div class="divide-y divide-blue-100">
            <% 
              // Sort candidates by vote count in descending order
              senatorCandidates.sort((a, b) => b.vote_count - a.vote_count);
              
              // Calculate metrics
              const highestVote = senatorCandidates.reduce((highest, candidate) => 
                candidate.vote_count > highest ? candidate.vote_count : highest, 0);
              
              const totalVotes = senatorCandidates.reduce((total, candidate) => 
                total + candidate.vote_count, 0);
                
              // Render candidates
              senatorCandidates.forEach(candidate => { 
                const votePercentage = totalVotes === 0 ? 0 : ((candidate.vote_count / totalVotes) * 100).toFixed(1);
                const isWinning = candidate.vote_count === highestVote && candidate.vote_count > 0;
              %>
            <div class="p-3 transition-colors duration-200 <%= isWinning ? 'bg-green-50' : 'hover:bg-blue-50' %>">
              <div class="flex items-center justify-between">
                <div class="flex items-center space-x-3">
                  <div class="relative flex-shrink-0">
                    <% if (candidate.candidate_profile) { %>
                    <img class="object-cover w-10 h-10 rounded-full border-2 <%= isWinning ? 'border-green-500' : 'border-blue-200' %>" src="/img/candidate_profiles/<%= candidate.candidate_profile %>" alt="<%= candidate.firstname %> <%= candidate.lastname %>">
                    <% } else { %>
                    <div class="flex items-center justify-center w-10 h-10 text-sm font-bold text-white <%= isWinning ? 'bg-green-500' : 'bg-blue-400' %> rounded-full">
                      <%= candidate.firstname.charAt(0) %><%= candidate.lastname.charAt(0) %>
                    </div>
                    <% } %>
                    <% if (isWinning) { %>
                    <div class="absolute flex items-center justify-center w-5 h-5 text-white bg-green-500 rounded-full -top-1 -right-1">
                      <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                      </svg>
                    </div>
                    <% } %>
                  </div>
                  <div>
                    <div class="flex items-center">
                      <p class="text-sm font-medium text-blue-900"><%= candidate.firstname %> <%= candidate.lastname %></p>
                      <% if (candidate.party) { %>
                      <span class="ml-1.5 px-1.5 py-0.5 text-xs font-medium rounded bg-blue-100 text-blue-700"><%= candidate.party %></span>
                      <% } %>
                    </div>
                    <p class="text-xs text-blue-600"><%= candidate.course %></p>
                  </div>
                </div>
                <div class="text-right">
                  <p class="text-base font-bold <%= isWinning ? 'text-green-600' : 'text-blue-600' %>">
                    <%= votePercentage %>%
                  </p>
                  <p class="text-xs text-blue-500"><%= candidate.vote_count %> votes</p>
                </div>
              </div>

              <!-- Vote percentage bar -->
              <div class="w-full h-1.5 mt-2 overflow-hidden bg-blue-100 rounded-full">
                <div class="h-full <%= isWinning ? 'bg-green-500' : 'bg-blue-400' %> rounded-full" style="width: <%= votePercentage %>%"></div>
              </div>
            </div>
            <% }); %>
          </div>
        </section>
        <% 
              }
            } else {
              // Handle other positions
              const candidatePerPosition = candidatesVoteTally.filter(candidate => candidate.position === position);
              
              if (candidatePerPosition.length > 0) {
                candidatePerPosition.sort((a, b) => b.vote_count - a.vote_count);
                const highestVoteInPosition = candidatePerPosition.reduce((highest, currentCandidateIteration) => 
                  currentCandidateIteration.vote_count > highest ? currentCandidateIteration.vote_count : highest, 0);
                const totalVotesInPosition = candidatePerPosition.reduce((total, candidateVotes) => 
                  total + candidateVotes.vote_count, 0);
          %>
        <section class="overflow-hidden bg-white border border-blue-200 rounded-lg shadow-sm animate-fade-in" style="animation-delay: <%= (posIndex * 0.05).toFixed(2) %>s">
          <div class="py-2 text-center text-white bg-blue-600">
            <h3 class="text-base font-medium"><%= position %></h3>
          </div>

          <div class="divide-y divide-blue-100">
            <% candidatePerPosition.forEach((candidate, index) => { 
                    const votePercentage = totalVotesInPosition === 0 ? 0 : ((candidate.vote_count / totalVotesInPosition) * 100).toFixed(1);
                    const isWinning = candidate.vote_count === highestVoteInPosition && candidate.vote_count > 0;
              %>
            <div class="p-3 transition-colors duration-200 <%= isWinning ? 'bg-green-50' : 'hover:bg-blue-50' %>">
              <div class="flex items-center justify-between">
                <div class="flex items-center space-x-3">
                  <div class="relative flex-shrink-0">
                    <% if (candidate.candidate_profile) { %>
                    <img class="object-cover w-10 h-10 rounded-full border-2 <%= isWinning ? 'border-green-500' : 'border-blue-200' %>" src="/img/candidate_profiles/<%= candidate.candidate_profile %>" alt="<%= candidate.firstname %> <%= candidate.lastname %>">
                    <% } else { %>
                    <div class="flex items-center justify-center w-10 h-10 text-sm font-bold text-white <%= isWinning ? 'bg-green-500' : 'bg-blue-400' %> rounded-full">
                      <%= candidate.firstname.charAt(0) %><%= candidate.lastname.charAt(0) %>
                    </div>
                    <% } %>
                    <% if (isWinning) { %>
                    <div class="absolute flex items-center justify-center w-5 h-5 text-white bg-green-500 rounded-full -top-1 -right-1">
                      <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                      </svg>
                    </div>
                    <% } %>
                  </div>
                  <div>
                    <div class="flex items-center">
                      <p class="text-sm font-medium text-blue-900"><%= candidate.firstname %> <%= candidate.lastname %></p>
                      <% if (candidate.party) { %>
                      <span class="ml-1.5 px-1.5 py-0.5 text-xs font-medium rounded bg-blue-100 text-blue-700"><%= candidate.party %></span>
                      <% } %>
                    </div>
                    <p class="text-xs text-blue-600"><%= candidate.course %></p>
                  </div>
                </div>
                <div class="text-right">
                  <p class="text-base font-bold <%= isWinning ? 'text-green-600' : 'text-blue-600' %>">
                    <%= votePercentage %>%
                  </p>
                  <p class="text-xs text-blue-500"><%= candidate.vote_count %> votes</p>
                </div>
              </div>

              <!-- Vote percentage bar -->
              <div class="w-full h-1.5 mt-2 overflow-hidden bg-blue-100 rounded-full">
                <div class="h-full <%= isWinning ? 'bg-green-500' : 'bg-blue-400' %> rounded-full" style="width: <%= votePercentage %>%"></div>
              </div>
            </div>
            <% }); %>
          </div>
        </section>
        <% 
              }
            }
          });
          %>
      </div>
      <% } %>
      <% } else { %>
      <!-- No positions available state -->
      <div class="p-6 text-center bg-white border border-blue-200 rounded-lg shadow-sm">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-12 h-12 mx-auto mb-3 text-blue-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
        </svg>
        <h2 class="text-lg font-medium text-blue-800">No Positions Available</h2>
        <p class="mt-1 text-sm text-blue-600">No positions or results are available for this election.</p>
      </div>
      <% } %>
    </div>

    <%
    function formatDateTime(date, time) {
      const [hours, minutes] = time.split(':');
      const dateTime = new Date(date);
      dateTime.setHours(parseInt(hours), parseInt(minutes));
      return dateTime.toLocaleString('en-US', { 
        dateStyle: 'short', 
        timeStyle: 'short' 
      });
    }
    %>
  </main>
</body>

</html>