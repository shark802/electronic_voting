<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Result</title>

  <link rel="stylesheet" href="/css/style.css">
  <script src="/javascript/lib/jquery-3.7.1.min.js"></script>
  <script src="/javascript/lib/socket.io.min.js" defer></script>
  <script type="module" src="/javascript/voter/electionResultForVoter.js"></script>

  <style>
    dialog::backdrop {
      background-color: rgba(0, 0, 0, 0.4);
    }
  </style>
</head>

<body class="w-full bg-blue-50 lg:px-0 h-dvh">

  <header class="flex items-center justify-between w-full px-4 py-3 shadow-md bg-gradient-to-r from-blue-800 to-blue-600">
    <a href="/election" class="flex items-center gap-2 px-3 py-2 text-white transition-colors duration-200 bg-blue-600 rounded-full shadow-md hover:text-blue-200 hover:bg-blue-700">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
      </svg>
      <span class="text-sm font-medium">Home</span>
    </a>

  </header>

  <div class="relative px-2 mt-8 overflow-y-auto lg:px-4 bg-blue-50">


    <div id="result-box" class="w-full lg:max-w-[750px] rounded-lg px-2 lg:px-4 py-3 lg:py-6 m-auto bg-white shadow-lg mb-10">
      <div class="mb-8 text-center">
        <h2 class="text-xl font-bold leading-tight text-blue-800 lg:mb-2 lg:text-3xl"><%= electionInfo.election_name %></h2>
        <p class="mb-2 text-gray-600 lg:text-lg">Election Results</p>
        <div class="flex flex-col items-center justify-center mb-4 space-y-2 sm:flex-row sm:space-y-0 sm:space-x-4">

          <div class="flex items-center text-xs text-gray-500 lg:text-sm">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 mr-1 text-blue-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
            <span class="font-medium">Start:</span>
            <%= formatDateTime(electionInfo.date_start, electionInfo.time_start) %>
          </div>

          <div class="flex items-center text-xs text-gray-500 lg:text-sm">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 mr-1 text-blue-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span class="font-medium">End:</span>
            <%= formatDateTime(electionInfo.date_end, electionInfo.time_end) %>
          </div>

        </div>

        <%
        function formatDateTime(date, time) {
          const [hours, minutes] = time.split(':');
          const dateTime = new Date(date);
          dateTime.setHours(parseInt(hours), parseInt(minutes));
          return dateTime.toLocaleString('en-US', { 
            dateStyle: 'medium', 
            timeStyle: 'short' 
          });
        }
        %>


        <% if (positionList && positionList.length > 0) { %>

        <% if (candidatesVoteTally.length < 1) { %>

        <div class="max-w-md mx-auto overflow-hidden bg-white rounded-lg shadow-sm">
          <div class="flex items-center p-6 space-x-4">
            <div class="flex-shrink-0">
              <svg class="w-12 h-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
              </svg>
            </div>
            <div>
              <h2 class="text-lg font-semibold text-gray-800">No Results to Display</h2>
              <p class="mt-1 text-sm text-gray-600">There are no candidates or results available for this election at the moment.</p>
            </div>
          </div>
        </div>

        <% } else { %>
        <% 

          positionList.forEach(position => {
            let candidatePerPosition = position === 'SENATOR'
              ? candidatesVoteTally.filter(candidate => candidate.course === user.course && candidate.position === position)
              : candidatesVoteTally.filter(candidate => candidate.position === position);

            if (candidatePerPosition.length > 0) {
              candidatePerPosition.sort((a, b) => b.vote_count - a.vote_count);
              const highestVoteInPosition = candidatePerPosition.reduce((highest, currentCandidateIteration) => currentCandidateIteration.vote_count > highest ? currentCandidateIteration.vote_count : highest, 0);
              const totalVotesInPosition = candidatePerPosition.reduce((total, candidateVotes) => total + candidateVotes.vote_count, 0);
          %>
        <section class="mb-8 overflow-hidden border border-gray-200 rounded-lg">
          <h3 class="w-full py-2 text-sm font-bold text-center text-white bg-blue-600 lg:text-lg"><%= position %></h3>

          <div class="divide-y divide-gray-200">
            <% candidatePerPosition.forEach((candidate, index) => { %>

            <div class="flex items-center justify-between p-2 lg:p-4 <%= candidate.vote_count === highestVoteInPosition ? 'bg-green-50' : 'hover:bg-gray-50' %> transition duration-150 ease-in-out">
              <div class="flex items-center space-x-4">
                <div class="flex-shrink-0">
                  <% if (candidate.candidate_profile) { %>
                  <img class="object-cover w-12 h-12 rounded-full" src="/img/candidate_profiles/<%= candidate.candidate_profile %>" alt="<%= candidate.firstname %> <%= candidate.lastname %>">
                  <% } else { %>
                  <div class="flex items-center justify-center font-bold text-gray-600 bg-gray-300 rounded-full h-9 w-9 lg:w-12 lg:h-12">
                    <%= candidate.firstname.charAt(0) %><%= candidate.lastname.charAt(0) %>
                  </div>
                  <% } %>
                </div>
                <div>
                  <p class="text-xs font-bold text-gray-800 text-nowrap lg:text-base"><%= candidate.firstname %> <%= candidate.lastname %></p>
                  <p class="text-xs text-left text-gray-500 lg:text-sm"><%= candidate.course %></p>
                </div>
              </div>
              <div class="text-right">
                <p class="lg:text-2xl text-lg font-bold <%= candidate.vote_count === highestVoteInPosition ? 'text-green-600' : 'text-gray-600' %>">
                  <%= totalVotesInPosition === 0 ? '0%' : ((candidate.vote_count / totalVotesInPosition) * 100).toFixed(2) + '%' %>
                </p>
                <p class="text-sm text-gray-500"><%= candidate.vote_count %> votes</p>
              </div>
            </div>
            <% }); %>
          </div>
        </section>
        <% 
            }
          });
          %>
        <% } %>
        <% } else { %>
        <div class="px-4 py-6 text-lg font-semibold text-center text-yellow-700 bg-yellow-100 border border-yellow-200 rounded-lg">
          <p>No positions or results available for this election</p>
        </div>
        <% } %>
      </div>

    </div>

</body>

</html>