<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Election Overview</title>
  <link rel="stylesheet" href="/css/style.css">
  <script src="/javascript/lib/jquery-3.7.1.min.js" defer></script>
  <script src="/javascript/lib/sweetalert2@11.js" defer></script>
  <script type="module" src="/javascript/programHead/dashboard-overview-program-head.js" defer></script>

  <style>
    #manage-population-modal::backdrop {
      background-color: rgba(0, 0, 0, 0.3);
    }
  </style>
</head>

<body class="w-[100vw] m-0 bg-blue-600 dvh flex overflow-hidden">

  <div id="sidebar" class="absolute z-10 w-full bg-black rounded-tr-md rounded-br-md bg-opacity-40 lg:block h-dvh lg:relative lg:w-1/5">

    <svg id="hide-sidebar" xmlns="http://www.w3.org/2000/svg" class="absolute w-10 h-10 m-2 bg-opacity-50 rounded-md right-4 top-4 bg-slate-500 lg:hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
    </svg>

    <nav class="relative z-10 flex flex-col w-4/5 px-2 pt-2 font-sans bg-white rounded-tr-lg rounded-br-lg h-dvh lg:w-full">

      <div class="text-white rounded-md bg-gradient-to-r from-blue-600 to-blue-800">
        <div class="flex items-center justify-between p-4">
          <div class="flex items-center space-x-3">
            <img src="/img/bcc-logo.webp" alt="BCC Logo" class="w-10 h-10 p-1 bg-white rounded-full">
            <div>
              <h1 class="text-sm font-bold leading-tight">BCC WEB BASED E-VOTING</h1>
              <p class="text-xs text-blue-200">WITH FACE RECOGNITION</p>
            </div>
          </div>
          <button id="hide-sidebar" class="p-2 text-white rounded-full hover:bg-blue-700 lg:hidden focus:outline-none">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
        <div class="px-4 py-2 bg-blue-800 bg-opacity-50 rounded-md">
          <p class="text-sm font-medium">Program Head Dashboard</p>
        </div>
      </div>

      <hr class="my-4 border-gray-200">

      <ul class="no-scrollbar overflow-auto overflow-x-hidden max-h-[77%] scroll-m-0 py-2 space-y-1">

        <li class="w-full">
          <div class="relative block w-full">
            <a href="/program-head/dashboard/overview" class="flex items-center px-4 py-2 text-gray-700 transition-colors duration-150 ease-in-out rounded-md hover:bg-gray-100 hover:text-gray-900">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 mr-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
              </svg>
              <span id="dashboard_nav" class="text-sm font-medium">Dashboard</span>
            </a>
            <div id="dashboard_subpage" class="pl-4 mt-1 space-y-1 border-l-2 border-gray-400 ml-7">
              <a id="overview_page" href="/program-head/dashboard/overview" class="block py-1 pl-2 text-sm text-gray-600 hover:text-gray-900">Overview</a>
              <a id="vote_tally_page" href="/program-head/dashboard/vote-tally" class="block py-1 pl-2 text-sm text-gray-600 hover:text-gray-900">Vote Tally</a>
            </div>
          </div>
        </li>

      </ul>

      <div class="p-4 mt-auto border-t border-gray-200">
        <button id="logout-button" class="flex items-center justify-center w-full px-4 py-2 text-sm font-medium text-white transition-colors duration-150 ease-in-out bg-red-600 rounded-md hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-red-500 focus:ring-offset-2">
          <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" stroke="currentColor" class="w-6 h-6 mr-2">
            <path d="M9.00195 7C9.01406 4.82497 9.11051 3.64706 9.87889 2.87868C10.7576 2 12.1718 2 15.0002 2L16.0002 2C18.8286 2 20.2429 2 21.1215 2.87868C22.0002 3.75736 22.0002 5.17157 22.0002 8L22.0002 16C22.0002 18.8284 22.0002 20.2426 21.1215 21.1213C20.2429 22 18.8286 22 16.0002 22H15.0002C12.1718 22 10.7576 22 9.87889 21.1213C9.11051 20.3529 9.01406 19.175 9.00195 17" stroke-width="1.5" stroke-linecap="round"></path>
            <path d="M15 12L2 12M2 12L5.5 9M2 12L5.5 15" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
          <span>Logout</span>
        </button>
      </div>
    </nav>
  </div>

  <!-- Main Content -->
  <main class="relative flex flex-col w-full m-auto overflow-y-auto lg:w-4/5 no-scrollbar h-dvh lg:px-2">

    <div class="flex items-center w-full py-3 m-0 lg:h-20 lg:pt-7">
      <img id="show-sidebar" src="/img/menu.webp" alt="menu" class="w-6 h-6 m-3 ml-5 lg:hidden ">
      <h1 class="relative m-auto font-sans text-2xl font-bold text-white -translate-x-4 justify-items-center lg:text-3xl">Election Overview</h1>
    </div>

    <div id="overview-container" class="relative h-full p-2 mt-3 overflow-hidden overflow-x-hidden overflow-y-auto rounded-lg lg:p-5 lg:mb-3 bg-blue-50 no-scrollbar">
      <input type="hidden" id="program" value="<%= user.course %>">
      <% 
      
      if (elections && elections.length > 0) {
        elections.forEach(election => {

      %>

      <section id="election-section" data-election-id="<%= election.election_id %>" class="pb-2 mb-8 bg-gray-100 border border-gray-300 rounded-sm shadow-md ">

        <input id="date-end" type="hidden" value="<%= election.date_end %>">
        <input id="time-end" type="hidden" value="<%= election.time_end %>">

        <div class="flex items-center justify-between p-4 text-white rounded-lg shadow-lg bg-gradient-to-r from-blue-600 to-blue-700">
          <div>
            <h2 class="text-xl font-bold lg:text-2xl"><%= election.election_name %></h2>
            <p id="election-id" class="mt-1 text-sm text-blue-100 opacity-80"><%= election.election_id %></p>
          </div>
          <div class="flex items-center space-x-2">
            <span id="election-status" class="px-3 py-1 text-xs font-medium bg-blue-500 rounded-full"><%= election.is_active ? 'Active' : 'Inactive' %></span>

          </div>
        </div>

        <div class="flex flex-grow w-full gap-1 px-1 py-2 mt-2 lg:px-3 lg:gap-3">
          <div class="w-1/3 p-2 border border-blue-700 rounded-md bg-gradient-to-r from-blue-600 to-blue-700 lg:py-6 lg:px-4 min-h-20">
            <div class="flex flex-wrap items-center lg:flex-nowrap">
              <img src="/img/population.webp" class="relative w-5 mr-1 lg:mr-3 lg:w-8 lg:top-[2px]" alt="population">
              <div class="min-h-8">
                <p id="total-population" class="text-xl font-bold text-white lg:text-4xl">N/A</p>
              </div>
            </div>
            <p class="pt-1 text-xs font-medium text-white lg:text-sm">Total students</p>
          </div>

          <div class="w-1/3 p-2 border border-green-500 rounded-md bg-gradient-to-r from-green-600 to-green-700 lg:py-6 lg:px-4 min-h-20">
            <div class="min-h-8">
              <div class="flex flex-wrap items-center lg:flex-nowrap">
                <img src="/img/like.webp" class="relative lg:w-8 w-5 lg:mr-3 mr-1 top-[1px]" alt="like">
                <p id="total-voted" class="text-lg font-bold text-white lg:text-4xl">0</p>
                <span id="total-voted-percentage" class="mx-3 text-lg font-semibold text-white lg:text-4xl lg:mx-5"> </span>
              </div>
            </div>
            <p class="pt-1 text-xs font-medium text-white lg:text-sm">Voted</p>
          </div>

          <div class="w-1/3 p-2 border border-red-500 rounded-md bg-gradient-to-r from-red-600 to-red-700 lg:py-6 lg:px-4 min-h-20">
            <div class="min-h-8">
              <div id="not-voted-overview" class="flex flex-wrap items-center lg:flex-nowrap">
                <img src="/img/dislike.webp" class="relative lg:w-8 w-5 lg:mr-3 mr-1 top-[3px]" alt="dislike">
                <p id="number-of-not-voted" class="text-xl font-bold text-white lg:text-4xl">N/A</p>
                <span id="not-voted-percentage" class="mx-3 text-xl font-semibold text-white lg:text-4xl lg:mx-5"></span>
              </div>
            </div>

            <p class="pt-1 text-xs font-medium text-white lg:text-sm">Not voted</p>
          </div>

        </div>

        <div class="grid gap-1 px-1 py-2 lg:gap-2 lg:px-3">
          <%
          if (user) {
          %>

          <div id="program" class="w-full pb-2 text-center bg-white border rounded-md shadow-sm min-h-10">

            <div id="program-code" class="py-1 text-sm font-bold text-center"> <%= user.course %> </div>

            <div class="flex flex-grow w-full gap-1 px-1 mt-2 lg:px-3 lg:gap-3">

              <div class="w-1/3 rounded-sm min-h-10">
                <div id="program-population" class="text-lg font-bold text-gray-600 lg:text-3xl"> N/A </div>
                <p class="font-medium text-gray-500">Total voter</p>
              </div>

              <div class="w-1/3 rounded-sm min-h-10">
                <div id="program-vote-count" class="text-lg font-bold text-gray-600 lg:text-3xl"> 0 </div>
                <p class="font-medium text-gray-500">Voted</p>
              </div>

              <div class="w-1/3 rounded-sm min-h-10">
                <div id="program-number-of-not-voted" class="text-lg font-bold text-gray-600 lg:text-3xl"> N/A </div>
                <p class="font-medium text-gray-500">Not voted</p>
              </div>

            </div>

          </div>

        </div>

      </section>

      <%
       }
       })
        } else { 
      %>

      <section class="lg:w-[600px] border-2 border-gray-300 lg:px-10 box-border shadow-sm bg-white rounded-md min-h-28 grid m-auto py-6 mt-7">
        <img src="/img/empty-folder.webp" alt="empty folder" class="w-20 h-20 m-auto lg:w-24 lg:h-24">
        <h1 class="m-auto mt-3 text-lg font-semibold text-center lg:w-3/5">It seems there are no active election at the moment</h1>

      </section>

      <%
      }
      %>

    </div>

  </main>

</body>

</html>