<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Election Events</title>

  <link rel="stylesheet" href="/css/style.css">
  <script src="/javascript/lib/jquery-3.7.1.min.js" defer></script>
  <script src="/javascript/lib/sweetalert2@11.js" defer></script>
  <script type="module" src="/javascript/admin/election_view.js" defer></script>
  <style>
    dialog::backdrop {
      background-color: rgba(0, 0, 0, 0.5);
    }
  </style>
</head>

<body class="w-[100vw] m-0 bg-blue-600 dvh flex overflow-hidden">

  <%- include("../partials/sidebar.ejs") %>

  <main class="relative flex flex-col w-full m-auto overflow-y-auto lg:w-4/5 no-scrollbar h-dvh lg:px-5">

    <div class="flex items-center w-full py-2 m-0 lg:h-20 lg:pt-7 ">
      <img id="show-sidebar" src="/img/menu.webp" alt="menu" class="w-6 h-6 m-3 ml-5 lg:hidden">
      <h1 class="relative m-auto font-sans text-2xl font-bold text-white -translate-x-4 justify-items-center lg:text-3xl">Manage Election</h1>
    </div>

    <div class="relative h-full pt-10 mt-3 overflow-hidden overflow-x-hidden overflow-y-auto rounded-lg scroll-smooth lg:mb-3 bg-blue-50 no-scrollbar">

      <% if (elections.length < 1) { %>

      <section class="lg:w-[700px] border-2 border-gray-300 lg:px-10 box-border shadow-sm bg-white rounded-md min-h-28 grid m-auto py-9">
        <img src="/img/empty-folder.webp" alt="empty folder" class="m-auto w-28 h-28">
        <h1 class="m-auto mt-5 text-lg font-semibold text-center lg:w-3/5">It seems there are no elections scheduled at the moment</h1>

        <a href="/admin/election/new" class="m-auto">
          <button class="px-2 py-1 m-auto mt-5 text-white bg-blue-500 rounded-md w-fit">Create Election?</button>
        </a>
      </section>

      <% } else { %>

      <% elections.forEach(element => { %>

      <section id="election-card" class="lg:w-[700px] shadow-sm border-2 border-gray-300 w-full bg-white rounded-md min-h-fit m-auto py-4 lg:px-12 px-3 pb-7 mb-4">

        <div id="electionSection" class="relative flex justify-between pb-1">

          <div class="relative pt-4 ml-2">
            <p class="px-3 text-sm text-green-500 bg-green-100 rounded-full w-fit">Active</p>
            <h2 id="election-title" class="font-semibold text-gray-700 lg:text-3xl"><%= element.election_name %> </h2>
            <p id="election-card-id" class="mb-4 text-gray-400"><%= element.election_id %></p>
          </div>

          <div id="option-section" class="absolute right-0 w-36 h-fit">
            <img id="more-button" src="/img/more.webp" alt="more" class="absolute w-6 transition-all rounded-full top-3 hover:cursor-pointer hover:bg-blue-200 right-2">

            <div id="more-option" class="absolute hidden gap-2 px-1 py-3 bg-white border border-solid rounded shadow-md w-36 h-fit top-11">

              <div id="election-edit-button" class="flex items-center px-3 my-2 transition-all rounded-sm hover:bg-blue-200">
                <img src="/img/pencil.webp" alt="edit" class="w-4 h-4">
                <p class="ml-2">Edit</p>
              </div>

              <% if (element.is_active === 1) { %>
              <div id="toggleElectionEventVisibility" class="flex items-center px-3 my-2 transition-all rounded-sm hover:bg-blue-200">
                <img id="viewStatusImage" src="/img/hide.webp" alt="hide" class="w-4 h-4">
                <p id="viewStatus" class="ml-2">Deactivate</p>
              </div>

              <% } else { %>
              <div id="toggleElectionEventVisibility" class="flex items-center px-3 my-2 transition-all rounded-sm hover:bg-blue-200">
                <img id="viewStatusImage" src="/img/view.webp" alt="view" class="w-4 h-4">
                <p id="viewStatus" class="ml-2">Activate</p>
              </div>

              <% } %>

              <div id="delete_election_button" class="flex items-center px-3 my-2 transition-all rounded-sm hover:bg-blue-200">
                <img src="/img/trash.webp" alt="delete" class="w-4 h-4">
                <p class="ml-2">Delete</p>
              </div>

            </div>
          </div>
        </div>

        <% 
        const formatOptions = {
          weekday: 'long',
          year: 'numeric',
          month: 'long',
          day: 'numeric',
          hour: 'numeric',
          minute: 'numeric',
        }
        
        const startDateTime = new Date(element.date_start);
        const [startHour, startMinute, startSecond] = element.time_start.split(":");
        startDateTime.setHours(startHour, startMinute, startSecond);
        const formattedStartDateTime = startDateTime.toLocaleString('en-US', formatOptions);

        const electionEndDateTime = new Date(element.date_end);
        const [endHour, endMinute, endSecond] = element.time_end.split(":");
        electionEndDateTime.setHours(endHour, endMinute, endSecond);
        const formattedEndDateTime = electionEndDateTime.toLocaleString('en-US', formatOptions);
        
         %>

        <div class="flex gap-2 m-auto text-sm text-center w-fit lg:text-base">
          <p class="font-semibold text-gray-700">Start:</p>
          <p id="displayStart" class="text-gray-600 "><%= formattedStartDateTime %></p>
        </div>

        <div class="flex gap-2 m-auto mt-2 text-sm text-center w-fit lg:text-base">
          <p class="font-semibold text-gray-700">End:</p>
          <p id="displayEnd" class="text-gray-600 "><%= formattedEndDateTime %></p>
        </div>

        <div class="flex justify-end">
          <button id="add-candidate" class="float-right px-3 py-1 mt-6 text-xs font-medium text-white bg-blue-500 rounded-md lg:text-base">Add Candidate</button>
        </div>

        <div id="election-info" class="hidden" data-date-start="<%= element.date_start %>" data-time-start="<%= element.time_start  %>"></div>

      </section>

      <% }) %>

      <% } %>

    </div>
  </main>

  <!-- Modal edit election -->
  <dialog id="election-edit-modal" class="rounded-lg">
    <div class="self-center mt-5 bg-white rounded-xl lg:w-[700px] min-h-96 max-w-4/5 auto max-h-3/5 shadow-lg">

      <form id="update_election_form" class="px-24 py-14">
        <span class="flex justify-end gap-2 text-sm text-gray-400">
          <p>Elecion ID: </p>
          <p id="election_id"></p>
        </span>

        <label for="election_name" class="text-sm">Election Name</label>
        <input id="election_name" type="text" class="w-full py-1 pl-4 mt-1 border-2 border-gray-400 border-solid rounded-sm focus:outline-blue-500">
        <div id="election_name_error_message" class="mb-2 text-sm text-red-500 h-7"></div>

        <h3 class="text-lg font-semibold">Start</h3>

        <div class="flex flex-1 gap-4">
          <div class="w-1/2">
            <label for="election_name" class="text-sm">Date</label><br>
            <input id="date_start" type="date" class="w-full py-1 pl-4 mt-1 border-2 border-gray-400 border-solid rounded-sm focus:outline-blue-500">
            <div id="startdate_error_message" class="h-5 text-sm text-red-500"></div>
          </div>

          <div class="w-1/2">
            <label for="election_name" class="text-sm">Time</label><br>
            <input id="time_start" type="time" class="w-full py-1 pl-4 mt-1 border-2 border-gray-400 border-solid rounded-sm focus:outline-blue-500">
            <div id="starttime_error_message" class="h-5 text-sm text-red-500"></div>
          </div>

        </div>

        <h3 class="m-auto text-lg font-semibold">End</h3>

        <div class="flex flex-1 gap-4 mb-4">
          <div class="w-1/2">
            <label for="election_name" class="text-sm">Date</label><br>
            <input id="date_end" type="date" class="w-full py-1 pl-4 mt-1 border-2 border-gray-400 border-solid rounded-sm focus:outline-blue-500">
            <div id="enddate_error_message" class="h-5 text-sm text-red-500"></div>
          </div>

          <div class="w-1/2">
            <label for="election_name" class="text-sm">Time</label><br>
            <input id="time_end" type="time" class="w-full py-1 pl-4 mt-1 border-2 border-gray-400 border-solid rounded-sm focus:outline-blue-500">
            <div id="endtime_error_message" class="h-5 text-sm text-red-500"></div>
          </div>

        </div>

        <div class="flex justify-end gap-2">
          <button id="closeModal" formmethod="dialog" type="button" class="px-3 py-1 mb-4 font-bold text-white bg-red-500 rounded-lg w-fit">CANCEL</button>
          <input type="submit" value="SAVE" class="px-3 py-1 mb-4 font-bold text-white bg-blue-500 rounded-lg">
        </div>
      </form>

    </div>
  </dialog>


</body>

</html>