<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Election Events</title>

  <link rel="stylesheet" href="/css/style.css">
  <script src="/javascript/lib/jquery-3.7.1.min.js"></script>
  <script src="/javascript/lib/sweetalert2@11.js"></script>
  <script type="module" src="/javascript/admin/election_view.js" defer></script>
  <style>
    dialog::backdrop {
      background-color: rgba(0, 0, 0, 0.5);
    }
  </style>
</head>

<body class="w-[100vw] m-0 bg-blue-600 dvh flex">

  <%- include("../partials/sidebar.ejs") %>

  <main class="relative flex flex-col w-4/5 h-dvh">

    <div class="w-full h-20">
      <h1 class="mt-6 font-sans text-4xl font-bold text-center text-white">Manage Election</h1>
    </div>

    <div class="flex flex-col w-full gap-6 pb-16 mt-12 overflow-y-auto min-h-96 auto max-h-3/5">

      <% if (elections.length < 1) { %>

      <section class="lg:w-[700px] bg-white rounded-md min-h-28">
        <p>No Election</p>
      </section>

      <% } else { %>

      <% elections.forEach(element => { %>

      <section id="election-card" class="lg:w-[700px] bg-white rounded-md min-h-fit m-auto py-5 lg:px-12 px-3 pb-9 mb-4">

        <div id="electionSection" class="relative flex justify-between pb-1">

          <div class="relative ml-2">
            <h2 class="pt-4 font-semibold lg:text-2xl"><%= element.election_name %></h2>
            <p id="election-card-id" class="mb-6 text-gray-400 text-md"><%= element.election_id %></p>
          </div>

          <div class="absolute right-0 w-36 h-fit">
            <img id="more-button" src="/img/more.png" alt="more" class="absolute w-6 transition-all rounded-full top-3 hover:cursor-pointer hover:bg-blue-200 right-2">

            <div id="more-option" class="absolute hidden gap-2 px-1 py-3 bg-white border border-solid rounded shadow-md w-36 h-fit top-11">

              <div id="election-edit-button" class="flex items-center px-3 my-2 transition-all rounded-sm hover:bg-blue-200">
                <img src="/img/pencil.png" alt="edit" class="w-4 h-4">
                <p class="ml-2">Edit</p>
              </div>

              <% if (element.is_active === 1) { %>
              <div id="toggleElectionEventVisibility" class="flex items-center px-3 my-2 transition-all rounded-sm hover:bg-blue-200">
                <img id="viewStatusImage" src="/img/hide.png" alt="hide" class="w-4 h-4">
                <p id="viewStatus" class="ml-2">Hide</p>
              </div>

              <% } else { %>
              <div id="toggleElectionEventVisibility" class="flex items-center px-3 my-2 transition-all rounded-sm hover:bg-blue-200">
                <img id="viewStatusImage" src="/img/view.png" alt="view" class="w-4 h-4">
                <p id="viewStatus" class="ml-2">View</p>
              </div>

              <% } %>

              <div id="delete_election_button" class="flex items-center px-3 my-2 transition-all rounded-sm hover:bg-blue-200">
                <img src="/img/trash.png" alt="delete" class="w-4 h-4">
                <p class="ml-2">Delete</p>
              </div>

            </div>
          </div>
        </div>

        <hr class="border-gray-400">
        <br>

        <% 
        const formatOptions = {
          weekday: 'long',
          year: 'numeric',
          month: 'long',
          day: 'numeric',
          hour: 'numeric',
          minute: 'numeric',
        }
        
        const startDateTime = new Date(element.date_start);
        const [startHour, startMinute, startSecond] = element.time_start.split(":");
        startDateTime.setHours(startHour, startMinute, startSecond);
        const formattedStartDateTime = startDateTime.toLocaleString('en-US', formatOptions);

        const electionEndDateTime = new Date(element.date_end);
        const [endHour, endMinute, endSecond] = element.time_end.split(":");
        electionEndDateTime.setHours(endHour, endMinute, endSecond);
        const formattedEndDateTime = electionEndDateTime.toLocaleString('en-US', formatOptions);
        
         %>

        <div class="flex gap-2 m-auto text-center w-fit">
          <p class="font-semibold">Start:</p>
          <p><%= formattedStartDateTime %></p>
        </div>

        <div class="flex gap-2 m-auto mt-3 text-center w-fit">
          <p class="font-semibold">End:</p>
          <p><%= formattedEndDateTime %></p>
        </div>

        <button id="add-candidate" class="float-right px-3 py-1 m-auto mt-6 text-white bg-blue-500 rounded-md ">Add Candidate</button>

      </section>

      <% }) %>

      <% } %>

    </div>
  </main>

  <!-- Modal -->

  <dialog id="election-edit-modal" class="rounded-lg">
    <div class="self-center mt-12 bg-white rounded-xl lg:w-[700px] min-h-96 max-w-4/5 auto max-h-3/5 shadow-lg">

      <form id="update_election_form" class="px-24 py-14">
        <span class="flex justify-end gap-2 text-sm text-gray-400">
          <p>Elecion ID: </p>
          <p id="election_id"></p>
        </span>

        <label for="election_name" class="text-sm">Election Name</label>
        <input id="election_name" type="text" class="w-full py-1 pl-4 mt-1 border-2 border-gray-400 border-solid rounded-sm focus:outline-blue-500" required>
        <div id="election_name_error_message" class="mb-2 text-sm text-red-500 h-7"></div>

        <h3 class="text-lg font-semibold">Start</h3>

        <div class="flex flex-1 gap-4">
          <div class="w-1/2">
            <label for="election_name" class="text-sm">Date</label><br>
            <input id="date_start" type="date" class="w-full pl-4 mt-1 border-2 border-gray-400 border-solid rounded-sm focus:outline-blue-500" required>
            <div id="startdate_error_message" class="h-5 text-sm text-red-500"></div>
          </div>

          <div class="w-1/2">
            <label for="election_name" class="text-sm">Time</label><br>
            <input id="time_start" type="time" class="w-full pl-4 mt-1 border-2 border-gray-400 border-solid rounded-sm focus:outline-blue-500" required>
            <div id="election_name_error_message" class="h-5 text-sm text-red-500"></div>
          </div>

        </div>

        <h3 class="m-auto text-lg font-semibold">End</h3>

        <div class="flex flex-1 gap-4 mb-4">
          <div class="w-1/2">
            <label for="election_name" class="text-sm">Date</label><br>
            <input id="date_end" type="date" class="w-full pl-4 mt-1 border-2 border-gray-400 border-solid rounded-sm focus:outline-blue-500" required>
            <div id="enddate_error_message" class="h-5 text-sm text-red-500"></div>
          </div>

          <div class="w-1/2">
            <label for="election_name" class="text-sm">Time</label><br>
            <input id="time_end" type="time" class="w-full pl-4 mt-1 border-2 border-gray-400 border-solid rounded-sm focus:outline-blue-500" required>
            <div id="endtime_error_message" class="h-5 text-sm text-red-500"></div>
          </div>

        </div>

        <div class="flex justify-end gap-2">
          <button id="closeModal" formmethod="dialog" type="button" class="px-3 py-1 mb-4 font-bold text-white bg-red-500 rounded-lg w-fit">CANCEL</button>
          <input type="submit" value="SAVE" class="px-3 py-1 mb-4 font-bold text-white bg-blue-500 rounded-lg">

        </div>
      </form>

    </div>
  </dialog>


</body>

</html>