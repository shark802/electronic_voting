<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Election Analytics</title>
  <link rel="stylesheet" href="/css/style.css">
  <script src="/javascript/lib/jquery-3.7.1.min.js"></script>
  <script src="/javascript/lib/socket.io.min.js" defer></script>
  <script src="/javascript/lib/sweetalert2@11.js"></script>
  <script src="/javascript/lib/chart.umd.min.js"></script>
  <script type="module" src="/javascript/admin/dashboard_analytics.js" defer></script>
</head>

<body class="w-[100vw] m-0 bg-blue-600 dvh flex overflow-hidden">

  <%- include("../partials/sidebar.ejs") %>

  <main class="relative flex flex-col w-full m-auto overflow-y-auto lg:w-4/5 no-scrollbar h-dvh lg:px-2">

    <header class="sticky top-0 flex items-center justify-between w-full px-4 py-3 bg-blue-600 shadow-md lg:h-20 lg:px-6">
      <button id="show-sidebar" class="p-2 text-white transition-colors duration-200 rounded-md lg:hidden hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-white focus:ring-opacity-50" aria-label="Toggle sidebar">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
      <h1 class="font-sans text-2xl font-bold text-white lg:text-3xl">Election Analytics</h1>
      <!-- <div class="flex items-center space-x-2">
        <button id="refresh-data" class="p-2 text-white transition-colors duration-200 rounded-md hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-white focus:ring-opacity-50" aria-label="Refresh data">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
          </svg>
        </button>
        <button id="user-menu" class="p-2 text-white transition-colors duration-200 rounded-md hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-white focus:ring-opacity-50" aria-label="User menu">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
          </svg>
        </button>
      </div> -->
    </header>

    <div class="relative h-screen p-3 mt-4 overflow-x-hidden overflow-y-auto bg-gradient-to-br from-blue-50 to-blue-100 rounded-xl lg:px-6 lg:p-6 lg:mb-3 shadow-lg">

      <!-- Main Analytics Container -->
      <div class="flex flex-col lg:flex-row gap-4">
        <!-- Voter Engagement Trends Card -->
        <div class="w-full lg:w-[85%] bg-white rounded-xl shadow-md hover:shadow-lg transition-shadow duration-300 p-5">
          <h2 class="p-3 text-xl font-bold text-gray-800 lg:text-2xl border-b border-gray-100">
            <i class="fas fa-chart-line mr-2 text-blue-600"></i>Voter Engagement Trends
          </h2>
          <div class="p-4">
            <canvas id="voter-engagement-trends" class="min-w-full lg:max-h-[370px]"></canvas>
          </div>
        </div>

        <!-- Stats Container -->
        <div class="flex flex-row lg:flex-col gap-3 lg:w-[15%]">
          <!-- Highest Turnout Card -->
          <div class="flex-1 bg-white p-4 rounded-xl shadow-md hover:shadow-lg transition-all duration-300 transform hover:-translate-y-1">
            <p class="mb-3 text-sm font-semibold text-center text-gray-700">Highest Turnout</p>
            <div class="relative w-24 h-24 mx-auto">
              <canvas id="highest-turnout-chart"></canvas>
              <div class="absolute inset-0 flex items-center justify-center">
                <span id="highest-turnout-text" class="text-lg font-bold text-green-500"></span>
              </div>
            </div>
          </div>

          <!-- Lowest Turnout Card -->
          <div class="flex-1 bg-white p-4 rounded-xl shadow-md hover:shadow-lg transition-all duration-300 transform hover:-translate-y-1">
            <p class="mb-3 text-sm font-semibold text-center text-gray-700">Lowest Turnout</p>
            <div class="relative w-24 h-24 mx-auto">
              <canvas id="lowest-turnout-chart"></canvas>
              <div class="absolute inset-0 flex items-center justify-center">
                <span id="lowest-turnout-text" class="text-lg font-bold text-red-500"></span>
              </div>
            </div>
          </div>

          <!-- Average Turnout Card -->
          <div class="flex-1 bg-white p-4 rounded-xl shadow-md hover:shadow-lg transition-all duration-300 transform hover:-translate-y-1">
            <p class="mb-3 text-sm font-semibold text-center text-gray-700">Average Turnout</p>
            <div class="relative w-24 h-24 mx-auto">
              <canvas id="average-turnout-chart"></canvas>
              <div class="absolute inset-0 flex items-center justify-center">
                <span id="average-turnout-text" class="text-lg font-bold text-blue-600"></span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Bottom Charts Container -->
      <div class="flex flex-col gap-4 mt-6 lg:flex-row">
        <!-- Year Level Engagement Card -->
        <div class="bg-white rounded-xl shadow-md hover:shadow-lg transition-shadow duration-300 lg:w-1/2">
          <h2 class="p-4 text-xl font-bold text-gray-800 lg:text-2xl border-b border-gray-100">
            <i class="fas fa-users mr-2 text-blue-600"></i>Year Level Engagement
          </h2>
          <div class="p-4">
            <canvas id="engagement-per-year-level" class="w-full h-full lg:max-h-[230px]"></canvas>
          </div>
        </div>

        <!-- Departments Engagement Card -->
        <div class="bg-white rounded-xl shadow-md hover:shadow-lg transition-shadow duration-300 lg:w-1/2">
          <h2 class="p-4 text-xl font-bold text-gray-800 lg:text-2xl border-b border-gray-100">
            <i class="fas fa-building mr-2 text-blue-600"></i>Departments Engagement
          </h2>
          <div class="p-4">
            <canvas id="engagement-per-department" class="w-full h-full lg:max-h-[230px]"></canvas>
          </div>
        </div>
      </div>

    </div>

  </main>

</body>

</html>