    </header>

    <div class="relative h-screen p-2 mt-3 overflow-x-hidden overflow-y-auto bg-blue-100 rounded-lg lg:gap-3 lg:px-5 lg:p-5 lg:mb-2">

      <div class="rounded-md shadow-sm">

        <h2 class="p-3 text-xl font-semibold lg:text-2xl">Voter Engagement Trends</h2>

        <canvas id="voter-engagement-trends" class="lg:max-h-[350px] w-full bg-white lg:px-4"></canvas>
        <div class="flex justify-end bg-white rounded-md">

          <div class="p-2 text-xs font-medium lg:text-sm lg:mx-4 min-w-fit text-nowrap lg:w-24 lg:h-20">
            <p class="text-xs">Highest Turnout</p>
            <p class="text-lg font-medium text-green-500">84.56%</p>
          </div>

          <div class="p-2 text-xs font-medium lg:text-sm lg:mx-4 min-w-fit text-nowrap lg:w-24 lg:h-20">
            <p class="text-xs">Lowest Turnout</p>
            <p class="text-lg font-medium text-red-500">34.23%</p>
          </div>

          <div class="p-2 text-xs font-medium lg:text-sm lg:mx-4 min-w-fit text-nowrap lg:w-24 lg:h-20">
            <p class="text-xs">Average Turnout</p>
            <p class="text-lg font-medium text-blue-600">78.06%</p>
          </div>
        </div>


      </div>

      <div class="flex flex-col gap-5 mt-5 lg:flex-row">
        <div class="h-64 bg-white rounded-md shadow-sm lg:w-1/2">
