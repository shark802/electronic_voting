<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Voter Activity</title>
  <link rel="stylesheet" href="/css/style.css">
  <script src="/javascript/lib/jquery-3.7.1.min.js"></script>
  <script src="/javascript/lib/sweetalert2@11.js"></script>
  <script type="module" src="/javascript/admin/voter_manage.js" defer></script>
</head>

<body class="w-[100vw] m-0 bg-blue-600 dvh flex">

  <%- include("../partials/sidebar.ejs") %>

  <main class="relative flex flex-col w-full m-auto overflow-y-auto lg:w-4/5 no-scrollbar h-dvh lg:px-5">

    <div class="flex items-center w-full py-3 m-0 lg:h-20 lg:pt-7">
      <img id="show-sidebar" src="/img/menu.webp" alt="menu" class="w-6 h-6 m-3 ml-5 lg:hidden ">
      <h1 class="relative m-auto font-sans text-2xl font-bold text-white -translate-x-4 justify-items-center lg:text-3xl">Voter Activity</h1>
    </div>

    <div class="relative h-full mt-3 overflow-hidden overflow-x-hidden overflow-y-auto rounded-lg lg:mb-3 bg-blue-50 no-scrollbar">

      <div class="lg:p-4 flex items-center justify-between p-2 pb-4  bg-white lg:h-[70px]">
        <form action="/admin/voter/manage" method="get" id="filter-voted-users-form" class="flex justify-between w-full">
          <div class="flex items-center gap-2">
            <label for="filter-by-election" class="hidden text-sm font-medium text-gray-500 lg:block">Filter by recent election: </label>
            <select name="election" id="filter-by-election" class="py-1 text-xs border border-gray-300 rounded-sm lg:text-sm lg:py-1 min-w-32 w-fit focus:outline-none lg:px-2">
              <option value="">--</option>
              <%
            if (availableElections && availableElections.length > 0) {
              availableElections.forEach(election => {
                %>

              <option value="<%= election.election_id %>"> <%= election.election_name %> </option>

              <%
              })
            }
            %>
            </select>
          </div>

          <div class="relative flex items-center py-0 text-xs border border-gray-300 rounded-full h-fit lg:text-sm">
            <input type="search" name="user_id" id="search-user" placeholder="Id number to search" class="px-2 py-1 rounded-full rounded-tr-none rounded-br-none lg:px-3 focus:outline-none focus:bg-blue-50">
            <button type="submit" class="relative w-6 px-2 lg:w-8"><img src="/img/magnifying-glass.webp" alt="search" class="absolute w-4 m-auto transform -translate-x-1/2 -translate-y-1/2 left-1/2 top-1/2 lg:w-6 opacity-70"></button>
          </div>
        </form>
      </div>

      <div class="w-full lg:px-3 h-[calc(100%-87px)] overflow-auto">

        <table class="w-full">
          <thead>
            <tr>
              <th class="sticky top-0 px-3 py-1 text-white bg-blue-500 text-nowrap font-xs lg:font-medium">Fullname</th>
              <th class="sticky top-0 px-3 py-1 text-white bg-blue-500 text-nowrap font-xs lg:font-medium">Id number</th>
              <th class="sticky top-0 px-3 py-1 text-white bg-blue-500 text-nowrap font-xs lg:font-medium">Crs/yr/sec</th>
              <th class="sticky top-0 px-3 py-1 text-white bg-blue-500 text-nowrap font-xs lg:font-medium">Election name</th>
              <th class="sticky top-0 px-3 py-1 text-white bg-blue-500 text-nowrap font-xs lg:font-medium">Election id</th>
              <th class="sticky top-0 px-3 py-1 text-white bg-blue-500 text-nowrap font-xs lg:font-medium">Time voted</th>
            </tr>
          </thead>

          <tbody>
            <%
            if(votedUsers && votedUsers.length > 0) {
              votedUsers.forEach(voter => {

                let candidateAddedAt = new Date(voter.time_casted);
                const options = {
                year: 'numeric',
                month: 'long',
                day: 'numeric',
                hour: '2-digit',
                minute: '2-digit',
                };

                const timeVoted = candidateAddedAt.toLocaleString('en-US', options);

            %>

            <tr class="tablerow">
              <td class="py-2 pl-2 text-sm font-medium text-gray-600 text-nowrap"> <%= voter.lastname %>, <%= voter.firstname %> </td>
              <td class="py-2 pl-2 text-sm font-medium text-center text-gray-600 text-nowrap"> <%= voter.id_number %> </td>
              <td class="py-2 pl-2 text-sm font-medium text-center text-gray-600 text-nowrap"> <%= voter.course %>-<%= voter.year_level %><%= voter.section %> </td>
              <td class="py-2 pl-2 text-sm font-medium text-center text-gray-600 text-nowrap"> <%= voter.election_name %> </td>
              <td class="py-2 pl-2 text-sm font-medium text-center text-gray-600 text-nowrap"> <%= voter.election_id %> </td>
              <td class="py-2 pl-2 text-sm font-medium text-center text-gray-600 text-nowrap"> <%= timeVoted %> </td>
            </tr>

            <%
              });

            }
            %>
          </tbody>
        </table>

        <%
        if (votedUsers.length <= 0) {
          %>
        <div class="p-3">
          <div class="m-auto text-center max-w-[600px] mt-2 rounded-md shadow-md bg-blue-100 p-7">
            <p class="text-xl font-semibold text-gray-600 lg:text-3xl">No Result Found</p>
          </div>
        </div>
        <%
        }
        
        %>

      </div>

    </div>

  </main>

</body>

</html>