<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Registered Device</title>
  <link rel="stylesheet" href="/css/style.css">
  <script src="/javascript/lib/jquery-3.7.1.min.js"></script>
  <script src="/javascript/lib/sweetalert2@11.js"></script>
  <script type="module" src="/javascript/admin/register-device_registered.js" defer></script>

  <style>
    #remove-device-modal::backdrop {
      background-color: rgba(0, 0, 0, 0.3);
    }
  </style>
</head>

<body class="w-[100vw] m-0 bg-blue-600 dvh flex">

  <%- include("../partials/sidebar.ejs") %>

  <main class="relative flex flex-col w-full m-auto overflow-y-auto lg:w-4/5 no-scrollbar h-dvh lg:px-2">

    <div class="flex items-center w-full py-3 m-0 lg:h-20 lg:pt-7">
      <img id="show-sidebar" src="/img/menu.webp" alt="menu" class="w-6 h-6 m-3 ml-5 lg:hidden ">
      <h1 class="relative m-auto font-sans text-xl font-bold text-white -translate-x-4 justify-items-center lg:text-3xl">Manage Registered Device</h1>
    </div>

    <div class="relative h-full px-3 mt-3 mb-2 overflow-hidden overflow-x-hidden overflow-y-auto rounded-lg bg-blue-50">

      <table id="registered-device-table" class="w-full">
        <thead class="px-4 py-4 text-gray-600">
          <tr class="">
            <th class="w-[20%] py-3 sticky top-0 bg-blue-50">Codename</th>
            <th class="w-[30%] py-3 sticky top-0 bg-blue-50">UUID</th>
            <th class="w-[25%] py-3 sticky top-0 bg-blue-50">Date Requested</th>
            <th class="w-[20%] py-3 sticky top-0 bg-blue-50"></th>
          </tr>
        </thead>

        <tbody>

          <% registeredDevices.forEach(device => {

            const formatOptions = {
                year: 'numeric',
                month: 'long',
                day: 'numeric',
                hour: '2-digit',
                minute: '2-digit',
            };
            let dateCreated = new Date(device.date_created).toLocaleString('en-US', formatOptions);
            
          %>
          <tr data-uuid="<%= device.uuid %>" class="transition-all tablerow">
            <td id="codename" class="py-1 text-xs font-medium text-center text-gray-700 rounded-tl-lg rounded-bl-lg"><%= device.codename %></td>
            <td id="uuid" class="py-1 text-xs font-medium text-center text-gray-700"><%= device.uuid %></td>
            <td id="request-date" class="py-1 text-xs font-medium text-center text-gray-700 "><%= dateCreated%></td>
            <td class="py-1 text-xs font-medium text-center text-gray-700 rounded-tr-lg rounded-br-lg ">
              <button popovertarget="remove-device-modal" id="remove-device" class="w-20 py-1 m-1 font-semibold text-center text-white bg-yellow-500 rounded-lg hover:bg-yellow-600">REMOVE</button>
            </td>
          </tr>
          <% }) %>

        </tbody>
      </table>
    </div>

    <div popover id="remove-device-modal" class="w-[95%] max-w-[500px] p-0 rounded-lg shadow-xl bg-white overflow-hidden">
      <div class="p-6 bg-yellow-100 border-b border-gray-200">
        <div class="flex items-center space-x-4">
          <div class="p-3 bg-yellow-500 rounded-full">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
            </svg>
          </div>
          <div>
            <h2 class="text-xl font-semibold text-yellow-600">Remove Device</h2>
            <p class="mt-1 text-sm text-yellow-600">
              Do you want to remove this device?
            </p>
          </div>
        </div>
      </div>

      <div class="p-6">
        <p class="mb-4 text-sm text-gray-700">
          This will remove the device from the registered devices list.
        </p>

        <div class="p-4 mb-6 rounded-md bg-gray-50">
          <div class="grid grid-cols-3 gap-2 text-sm">
            <p class="text-gray-600">Codename:</p>
            <p id="codename" class="col-span-2 font-medium text-gray-800"></p>

            <p class="text-gray-600">UUID:</p>
            <p id="uuid" class="col-span-2 font-medium text-gray-800 break-all"></p>

            <p class="text-gray-600">Request date:</p>
            <p id="request-date" class="col-span-2 font-medium text-gray-800"></p>
          </div>
        </div>

        <div class="flex justify-end space-x-4">
          <button popovertarget="remove-device-modal" class="px-4 py-2 text-gray-600 transition-colors duration-200 hover:text-gray-800">
            Cancel
          </button>
          <button popovertarget="remove-device-modal" id="confirm-remove" class="px-4 py-2 text-white transition-colors duration-200 bg-yellow-500 rounded-md hover:bg-yellow-600 focus:outline-none focus:ring-2 focus:ring-yellow-500 focus:ring-opacity-50">
            Confirm
          </button>
        </div>
      </div>
    </div>

  </main>

</body>

</html>