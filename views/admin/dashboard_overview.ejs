<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Election Overview</title>
  <link rel="stylesheet" href="/css/style.css">
  <script src="/javascript/lib/jquery-3.7.1.min.js" defer></script>
  <script src="/javascript/lib/sweetalert2@11.js" defer></script>
  <script type="module" src="/javascript/admin/dashboard_overview.js" defer></script>

  <style>
    #manage-population-modal::backdrop {
      background-color: rgba(0, 0, 0, 0.3);
    }
  </style>
</head>

<body class="w-[100vw] m-0 bg-blue-600 dvh flex overflow-hidden">

  <%- include("../partials/sidebar.ejs") %>

  <main class="relative flex flex-col w-full m-auto overflow-y-auto lg:w-4/5 no-scrollbar h-dvh lg:px-5">

    <div class="flex items-center w-full py-3 m-0 lg:h-20 lg:pt-7">
      <img id="show-sidebar" src="/img/menu.webp" alt="menu" class="w-6 h-6 m-3 ml-5 lg:hidden ">
      <h1 class="relative m-auto font-sans text-2xl font-bold text-white -translate-x-4 justify-items-center lg:text-3xl">Election Overview</h1>
    </div>

    <div id="overview-container" class="relative h-full p-2 mt-3 overflow-hidden overflow-x-hidden overflow-y-auto rounded-lg lg:p-5 lg:mb-3 bg-blue-50 no-scrollbar">

      <% 
      
    if (elections && elections.length > 0) { 
        elections.forEach(election => {

      %>

      <section data-election-id="<%= election.election_id %>" class="pb-3 mb-5 bg-gray-100 border border-gray-300 rounded-sm shadow-md">

        <input id="date-end" type="hidden" value="<%= election.date_end %>">
        <input id="time-end" type="hidden" value="<%= election.time_end %>">

        <div class="flex justify-between p-3 text-white bg-blue-600 rounded-sm shadow-md lg:px-4">
          <div>
            <h2 class="text-lg font-semibold lg:text-2xl"> <%= election.election_name %> </h2>
            <p id="election-id" class="text-sm text-blue-100"> <%= election.election_id %> </p>
          </div>

          <button id="manage" class="text-sm font-medium focus:outline-none">MANAGE</button>
        </div>

        <div class="flex flex-grow w-full gap-1 px-1 py-2 mt-2 lg:px-3 lg:gap-3">

          <div class="w-1/3 p-2 bg-blue-500 border border-blue-700 rounded-md lg:py-4 lg:px-4 min-h-20">

            <div class="flex flex-wrap items-center lg:flex-nowrap">
              <img src="/img/population.webp" class="relative w-5 mr-1 lg:mr-3 lg:w-8 lg:top-[2px]" alt="population">
              <%
              const totalPopulation = election.total_populations !== 0 ? election.total_populations : "N/A"
              %>

              <div class="min-h-8">
                <p id="total-population" class="text-xl font-bold text-white lg:text-4xl"><%= totalPopulation %></p>
              </div>
            </div>

            <p class="pt-1 text-xs font-medium text-white lg:text-sm">Total students</p>
          </div>

          <div class="w-1/3 p-2 bg-green-200 border border-green-500 rounded-md lg:py-4 lg:px-4 min-h-20">

            <div class="min-h-8">
              <div class="flex flex-wrap items-center lg:flex-nowrap">
                <img src="/img/like.webp" class="relative lg:w-8 w-5 lg:mr-3 mr-1 top-[1px]" alt="like">

                <%
               const findAvailableTotalVotes = totalVotedPerElection.filter(total => total.election_id === election.election_id);
               const totalVoted = findAvailableTotalVotes.length > 0 ? findAvailableTotalVotes[0].total_voted : 0;              
               %>
                <p id="total-voted" class="text-lg font-bold text-green-600 lg:text-4xl"><%= totalVoted %></p>

                <%
                if (totalVoted && totalPopulation != 'N/A') {
                %>

                <span class="mx-3 text-lg font-bold text-green-600 lg:text-4xl lg:mx-5"> (<%= ((totalVoted / totalPopulation )* 100).toFixed(2) %>%) </span>

                <%
                } 
                %>

              </div>
            </div>

            <p class="pt-1 text-xs font-medium text-green-600 lg:text-sm">Voted</p>
          </div>

          <div class="w-1/3 p-2 bg-red-200 border border-red-500 rounded-md lg:py-4 lg:px-4 min-h-20">

            <div class="min-h-8">
              <div id="not-voted-overview" class="flex flex-wrap items-center lg:flex-nowrap">
                <img src="/img/dislike.webp" class="relative lg:w-8 w-5 lg:mr-3 mr-1 top-[3px]" alt="dislike">

                <%
              const totalVotedInElection = totalVotedPerElection.filter(total => total.election_id === election.election_id);
              const notVotedInElection = Number(election.total_populations) == 0 ? 'N/A' : (election.total_populations - totalVoted)
              %>
                <p id="number-of-not-voted" class="text-xl font-bold text-red-600 lg:text-4xl"> <%= notVotedInElection  %> </p>

                <%
                if (notVotedInElection !== 'N/A') {
                %>

                <span id="not-voted-percentage" class="mx-3 text-xl font-bold text-red-600 tet-lg lg:text-4xl lg:mx-5"> (<%= ((notVotedInElection / totalPopulation )* 100).toFixed(2) %>%) </span>

                <%
                }
                %>

              </div>
            </div>

            <p class="pt-1 text-xs font-medium text-red-600 lg:text-sm">Not voted</p>
          </div>

        </div>

        <div class="grid gap-1 px-1 py-2 lg:gap-2 lg:px-3">
          <%
          const courses = populationPerProgram.filter(program => program.election_id === election.election_id).sort((a, b) => a.program_code.localeCompare(b.program_code));
          courses.forEach(course => {

            const findTotalVotedInProgram = totalVotedPerProgram.filter(total => total.election_id === election.election_id && total.course === course.program_code);
            const totalVotedInProgram = findTotalVotedInProgram.length > 0 ? findTotalVotedInProgram[0].total_voted : 0;
          %>

          <div id="program" class="w-full pb-2 text-center bg-white border rounded-md shadow-sm min-h-10">

            <div id="program-code" class="py-1 text-sm font-bold text-center"> <%= course.program_code %> </div>

            <div class="flex flex-grow w-full gap-1 px-1 mt-2 lg:px-3 lg:gap-3">

              <div class="w-1/3 rounded-sm min-h-10">
                <div id="program-population" class="text-lg font-bold text-gray-600 lg:text-3xl"> <%= course.program_population === 0 ? 'N/A' : course.program_population %> </div>
                <p class="font-medium text-gray-500">Total voter</p>
              </div>

              <div class="w-1/3 rounded-sm min-h-10">
                <div class="text-lg font-bold text-gray-600 lg:text-3xl"> <%= totalVotedInProgram %> </div>
                <p class="font-medium text-gray-500">Voted</p>
              </div>

              <div class="w-1/3 rounded-sm min-h-10">
                <div class="text-lg font-bold text-gray-600 lg:text-3xl"> <%= course.program_population === 0 ? 'N/A' : course.program_population - totalVotedInProgram %> </div>
                <p class="font-medium text-gray-500">Not voted</p>
              </div>

            </div>

          </div>

          <%
          })
          %>

        </div>

      </section>

      <%
        })
     } else { 
      %>

      <section class="lg:w-[700px] border-2 border-gray-300 lg:px-10 box-border shadow-sm bg-white rounded-md min-h-28 grid m-auto py-6 mt-7">
        <img src="/img/empty-folder.webp" alt="empty folder" class="m-auto w-28 h-28">
        <h1 class="m-auto mt-3 text-lg font-semibold text-center lg:w-3/5">It seems there are no active election at the moment</h1>

        <a href="/admin/election/new" class="m-auto">
          <button class="px-2 py-1 m-auto mt-5 text-white bg-blue-500 rounded-md w-fit">Create Election?</button>
        </a>
      </section>

      <%
     }
      %>

    </div>

  </main>

  <dialog id="manage-population-modal" class="w-[95%] px-5 py-9 lg:py-8 lg:px-12 max-w-[600px] min-h-fit rounded-md shadow-md">
    <img src="/img/x.webp" id="close-modal" alt="exit" class="absolute rounded-full w-7 top-3 right-3 opacity-70 hover:bg-blue-200">

    <form id="manage-election-population" class="focus:outline-none">
      <input type="hidden" id="hidden-election-id">
      <h2 class="mb-5 text-xl font-bold text-center ">Manage voter population</h2>

      <div id="input-container" class="py-4 m-auto lg:w-2/3">

      </div>

      <div class="py-2 m-auto lg:w-2/3">
        <label for='total-voter' class="inline-block w-1/3 font-bold text-blue-500">Total Voter</label>
        <input type="text" id='total-voter' value="" disabled class="py-2 pl-3 text-blue-500 bg-blue-100 border-2 border-blue-400 rounded-md focus:outline-blue-500">
      </div>

      <div class="flex justify-end pt-3">
        <button type="submit" class="w-fit block mt-3 text-white bg-blue-600 hover:bg-blue-800 focus:outline-none font-medium rounded-lg text-sm px-5 py-2.5 text-center">Save changes</button>
      </div>
    </form>

  </dialog>


  <dialog id="close-election" class="w-[95%] px-5 py-5 lg:py-8 lg:px-12 max-w-[600px] min-h-fit rounded-md shadow-md">
    <input type="hidden" id="election-id">

    <div class="px-5 py-6 bg-yellow-100 border-t-4 border-yellow-500 shadow-md">
      <div class="">
        <div class="flex items-center gap-2 ">
          <svg class="flex-shrink-0 w-4 h-4 text-[#eab308]" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 20 20">
            <path d="M10 .5a9.5 9.5 0 1 0 9.5 9.5A9.51 9.51 0 0 0 10 .5ZM9.5 4a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3ZM12 15H8a1 1 0 0 1 0-2h1v-3H8a1 1 0 0 1 0-2h2a1 1 0 0 1 1 1v4h1a1 1 0 0 1 0 2Z" />
          </svg>

          <p class="text-lg text-yellow-500">Election has ended</p>
        </div>

        <div class="pt-4 pl-4">
          The election has successfully concluded at <underline class="underline underline-offset-1"></underline>. All results have been recorded, and no further changes can be made. Please review the final outcomes and ensure all data is properly archived.
        </div>

      </div>
    </div>
    <p class="px-3 mt-5 font-medium text-gray-400 lg:px-5">Close Election Dashboard: Click the button to stop displaying election dashboard.</p>

    <div class="flex items-center justify-center gap-4 lg:gap-6">
      <button id="exit-close-election-modal" class="relative underline focus:outline-none underline-offset-4 top-1">Cancel</button>
      <button id="close-election-button" class="px-3 py-2 mt-4 text-sm font-semibold text-white bg-yellow-500 rounded-md focus:outline-none hover:bg-yellow-600">Close Election</button>
    </div>

  </dialog>

</body>

</html>