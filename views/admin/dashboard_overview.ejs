<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Election Overview</title>
  <link rel="stylesheet" href="/css/style.css">
  <script src="/javascript/lib/jquery-3.7.1.min.js" defer></script>
  <script src="/javascript/lib/sweetalert2@11.js" defer></script>
  <script type="module" src="/javascript/admin/dashboard_overview.js" defer></script>
</head>

<body class="w-[100vw] m-0 bg-blue-600 dvh flex overflow-hidden">

  <%- include("../partials/sidebar.ejs") %>

  <main class="relative flex flex-col w-full m-auto overflow-y-auto lg:w-4/5 no-scrollbar h-dvh lg:px-5">

    <div class="flex items-center w-full h-20 py-3 m-0 lg:pt-7">
      <img id="show-sidebar" src="/img/menu.webp" alt="menu" class="w-6 h-6 m-3 ml-5 lg:hidden ">
      <h1 class="relative m-auto font-sans text-2xl font-bold text-white -translate-x-4 justify-items-center lg:text-3xl">Election Overview</h1>
    </div>

    <div class="relative h-full p-2 mt-3 overflow-hidden overflow-x-hidden overflow-y-auto rounded-lg lg:p-5 lg:mb-3 bg-blue-50 no-scrollbar">

      <% 
      
    if (elections && elections.length > 0) { 
        elections.forEach(election => {

      %>

      <section class="pb-3 mb-5 bg-white border-2 border-gray-300">

        <div class="flex justify-between p-3 text-white bg-blue-600 rounded-sm shadow-md lg:px-4">
          <div>
            <h2 class="text-lg font-semibold lg:text-2xl"> <%= election.election_name %> </h2>
            <p class="text-sm text-blue-100"> <%= election.election_id %> </p>
          </div>

          <button class="text-sm font-medium">MANAGE</button>
        </div>

        <div class="flex flex-grow w-full gap-1 px-1 py-2 mt-2 lg:px-3 lg:gap-3">

          <div class="w-1/3 p-2 bg-blue-500 border border-blue-700 rounded-sm lg:px-4 min-h-20">

            <div class="flex items-center">
              <img src="/img/population.webp" class="relative mr-3 w-8 top-[2px]" alt="population">

              <div class="min-h-8">
                <p class="font-bold text-white tet-lg lg:text-4xl"><%= election.total_populations !== 0 ? election.total_populations : "N/A" %></p>
              </div>
            </div>

            <p class="pt-1 text-xs font-medium text-white lg:text-sm">Total students</p>
          </div>

          <div class="w-1/3 p-2 bg-green-200 border border-green-500 rounded-sm lg:px-4 min-h-20">

            <div class="min-h-8">
              <div class="flex items-center">
                <img src="/img/like.webp" class="relative w-8 mr-3 top-[1px]" alt="like">

                <%
               const findAvailableTotalVotes = totalVotedPerElection.filter(total => total.election_id === election.election_id);
               const totalVoted = findAvailableTotalVotes.length > 0 ? findAvailableTotalVotes[0].total_voted : 0;              
              %>
                <p class="font-bold text-green-600 tet-lg lg:text-4xl"><%= totalVoted %></p>
              </div>
            </div>

            <p class="pt-1 text-xs font-medium text-green-600 lg:text-sm">Voted</p>
          </div>

          <div class="w-1/3 p-2 bg-red-200 border border-red-500 rounded-sm lg:px-4 min-h-20">

            <div class="min-h-8">
              <div class="flex items-center">
                <img src="/img/dislike.webp" class="relative w-8 mr-3 top-[3px]" alt="dislike">

                <%
              const totalVotedInElection = totalVotedPerElection.filter(total => total.election_id === election.election_id);
              const notVotedInElection = election.total_populations === 0 ? 'N/A' : election.total_populations - totalVotedInElection.total_voted
              %>
                <p class="font-bold text-red-600 tet-lg lg:text-4xl"> <%= notVotedInElection  %> </p>
              </div>
            </div>

            <p class="pt-1 text-xs font-medium text-red-600 lg:text-sm">Not voted</p>
          </div>

        </div>

        <div class="grid gap-1 px-1 py-2 lg:gap-2 lg:px-3">
          <%
          courses.forEach(course => {
          %>

          <div class="w-full py-2 bg-blue-100 border border-gray-400 rounded-sm min-h-10">
            <div class="text-sm font-medium text-center"> <%= course %> </div>

            <div class="flex flex-grow w-full gap-1 px-1 mt-2 lg:px-3 lg:gap-3">
              <div class="w-1/3 rounded-sm min-h-10"></div>
              <div class="w-1/3 rounded-sm min-h-10"></div>
              <div class="w-1/3 rounded-sm min-h-10"></div>
            </div>

          </div>

          <%
          })
          %>

        </div>

      </section>

      <%
        })
     }
    %>

    </div>

  </main>

</body>

</html>