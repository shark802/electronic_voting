<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Election Overview</title>
  <link rel="stylesheet" href="/css/style.css">
  <script src="/javascript/lib/jquery-3.7.1.min.js" defer></script>
  <script src="/javascript/lib/sweetalert2@11.js" defer></script>
  <script type="module" src="/javascript/admin/dashboard_overview.js" defer></script>

  <style>
    #manage-population-modal::backdrop {
      background-color: rgba(0, 0, 0, 0.3);
    }
  </style>
</head>

<body class="w-[100vw] m-0 bg-blue-600 dvh flex overflow-hidden">

  <%- include("../partials/sidebar.ejs") %>

  <main class="relative flex flex-col w-full m-auto overflow-y-auto lg:w-4/5 no-scrollbar h-dvh lg:px-2">

    <div class="flex items-center w-full py-3 m-0 lg:h-20 lg:pt-7">
      <img id="show-sidebar" src="/img/menu.webp" alt="menu" class="w-6 h-6 m-3 ml-5 lg:hidden ">
      <h1 class="relative m-auto font-sans text-2xl font-bold text-white -translate-x-4 justify-items-center lg:text-3xl">Election Overview</h1>
    </div>

    <div id="overview-container" class="relative h-full p-2 mt-3 overflow-hidden overflow-x-hidden overflow-y-auto rounded-lg lg:p-5 lg:mb-2 bg-blue-50 no-scrollbar">

      <% if (elections && elections.length > 0) { 
        elections.forEach(election => { %>

      <section id="election-section" data-election-id="<%= election.election_id %>" class="pb-3 mb-5 border-2 rounded-md">
        <input id="date-end" type="hidden" value="<%= election.date_end %>">
        <input id="time-end" type="hidden" value="<%= election.time_end %>">

        <div class="flex justify-between p-3 text-white rounded-sm shadow-md bg-gradient-to-r from-blue-600 to-blue-700 lg:px-4 lg:py-5">
          <div>
            <h2 class="text-lg font-semibold lg:text-2xl"> <%= election.election_name %> </h2>
            <p id="election-id" class="text-sm font-medium text-blue-100"> <%= election.election_id %> </p>
          </div>

          <!-- <button id="manage" class="text-sm font-medium focus:outline-none">MANAGE</button> -->
        </div>

        <div class="flex flex-grow w-full gap-1 px-1 py-2 mt-2 lg:px-3 lg:gap-3">

          <div class="w-1/3 p-2 border border-blue-700 rounded-md bg-gradient-to-r from-blue-600 to-blue-700 lg:py-6 lg:px-4 min-h-20">
            <div class="flex flex-wrap items-center lg:flex-nowrap">
              <img src="/img/population.webp" class="relative w-5 mr-1 lg:mr-3 lg:w-8 lg:top-[2px]" alt="population">
              <p id="total-population" class="text-xl font-bold text-white lg:text-4xl"> <%= election.total_populations || "N/A" %> </p>
              <span id="total-population-percentage" class="mx-3 text-lg font-semibold text-white lg:text-4xl lg:mx-5"> </span>
            </div>
            <p class="pt-1 text-xs font-medium text-white lg:text-sm">Total students</p>
          </div>

          <div class="w-1/3 p-2 border border-green-500 rounded-md bg-gradient-to-r from-green-600 to-green-700 lg:py-6 lg:px-4 min-h-20">
            <div class="flex flex-wrap items-center lg:flex-nowrap">
              <img src="/img/like.webp" class="relative w-5 mr-1 lg:w-8 lg:mr-3" alt="like">
              <p id="total-voted" class="text-lg font-bold text-white lg:text-4xl">0</p>
              <span id="total-voted-percentage" class="mx-3 text-lg font-semibold text-white lg:text-4xl lg:mx-5"> (0.00%) </span>
            </div>
            <p class="pt-1 text-xs font-medium text-white lg:text-sm">Voted</p>
          </div>

          <div class="w-1/3 p-2 border border-red-500 rounded-md bg-gradient-to-r from-red-600 to-red-700 lg:py-6 lg:px-4 min-h-20">
            <div class="flex flex-wrap items-center lg:flex-nowrap">
              <img src="/img/dislike.webp" class="relative lg:w-8 w-5 lg:mr-3 mr-1 top-[3px]" alt="dislike">
              <p id="number-of-not-voted" class="text-xl font-bold text-white lg:text-4xl">N/A</p>
              <span id="total-not-voted-percentage" class="mx-3 text-lg font-semibold text-white lg:text-4xl lg:mx-5"> </span>
            </div>
            <p class="pt-1 text-xs font-medium text-white lg:text-sm">Not voted</p>
          </div>

        </div>

        <div class="grid gap-1 px-1 py-2 lg:gap-2 lg:px-3">
          <% populationPerProgram.filter(program => program.election_id === election.election_id).forEach(course => { %>
          <div id="program" class="w-full text-center transition-all bg-white border-2 rounded-md shadow-sm border-gray-50 lg:flex min-h-10 lg:py-4 hover:bg-blue-50 hover:border-blue-200">
            <div id="program-code" class="flex items-center justify-center py-1 text-lg font-bold text-center text-gray-700 lg:text-4xl lg:w-1/4"> <%= course.program_code %> </div>
            <div class="flex flex-grow w-full gap-1 px-1 pb-2 mt-2 lg:px-10 lg:gap-3">
              <div class="w-1/3 rounded-sm min-h-10">
                <p id="program-population" class="text-lg font-bold text-gray-600 lg:text-3xl"><%= course.program_population === 0 ? 'N/A' : course.program_population %></p>
                <p class="font-medium text-gray-500">Total voter</p>
              </div>
              <div class="w-1/3 rounded-sm min-h-10">
                <p class="text-lg font-bold text-gray-600 lg:text-3xl">0</p>
                <p class="font-medium text-gray-500">Voted</p>
              </div>
              <div class="w-1/3 rounded-sm min-h-10">
                <p class="text-lg font-bold text-gray-600 lg:text-3xl">N/A</p>
                <p class="font-medium text-gray-500">Not voted</p>
              </div>
            </div>
          </div>
          <% }) %>
        </div>

      </section>

      <% }) } else { %>

      <section class="lg:w-[700px] border-2 border-gray-300 lg:px-10 box-border shadow-sm bg-white rounded-md min-h-28 grid m-auto py-6 mt-7">
        <img src="/img/empty-folder.webp" alt="empty folder" class="m-auto w-28 h-28">
        <h1 class="m-auto mt-3 text-lg font-semibold text-center lg:w-3/5">It seems there are no active elections at the moment</h1>
        <a href="/admin/election/new" class="m-auto">
          <button class="px-2 py-1 m-auto mt-5 text-white bg-blue-500 rounded-md w-fit">Create Election?</button>
        </a>
      </section>

      <% } %>

    </div>

  </main>

  <dialog id="manage-population-modal" class="w-[95%] px-5 py-9 lg:py-8 lg:px-12 max-w-[600px] min-h-fit rounded-md shadow-md">
    <img src="/img/x.webp" id="close-modal" alt="exit" class="absolute rounded-full w-7 top-3 right-3 opacity-70 hover:bg-blue-200">
    <form id="manage-election-population" class="focus:outline-none">
      <input type="hidden" id="hidden-election-id">
      <h2 class="mb-5 text-xl font-bold text-center ">Manage voter population</h2>
      <div id="input-container" class="py-4 m-auto lg:w-2/3"></div>
      <div class="py-2 m-auto lg:w-2/3">
        <label for='total-voter' class="inline-block w-1/3 font-bold text-blue-500">Total Voter</label>
        <input type="text" id='total-voter' value="" disabled class="py-2 pl-3 text-blue-500 bg-blue-100 border-2 border-blue-400 rounded-md focus:outline-blue-500">
      </div>
      <div class="flex justify-end pt-3">
        <button type="submit" class="w-fit block mt-3 text-white bg-blue-600 hover:bg-blue-800 focus:outline-none font-medium rounded-lg text-sm px-5 py-2.5 text-center">Save changes</button>
      </div>
    </form>
  </dialog>

  <dialog id="close-election" class="w-[95%] px-5 py-9 lg:py-8 lg:px-12 max-w-[600px] min-h-fit rounded-md shadow-md">
    <img src="/img/x.webp" id="exit-close-election-modal" alt="exit" class="absolute rounded-full w-7 top-3 right-3 opacity-70 hover:bg-blue-200">
    <form id="close-election-form" class="focus:outline-none">
      <input type="hidden" id="hidden-election-close-id">
      <h2 class="mb-5 text-xl font-bold text-center ">Close election</h2>
      <div class="py-2 m-auto lg:w-2/3">
        <label for='total-voters' class="inline-block w-1/3 font-bold text-blue-500">Total Voter</label>
        <input type="text" id='total-voters' value="" disabled class="py-2 pl-3 text-blue-500 bg-blue-100 border-2 border-blue-400 rounded-md focus:outline-blue-500">
      </div>
      <div class="flex justify-end pt-3">
        <button type="submit" class="w-fit block mt-3 text-white bg-blue-600 hover:bg-blue-800 focus:outline-none font-medium rounded-lg text-sm px-5 py-2.5 text-center">Confirm</button>
      </div>
    </form>
  </dialog>
</body>

</html>