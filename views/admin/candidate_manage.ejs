<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Manage Candidate</title>
  <link rel="stylesheet" href="/css/style.css">
  <script src="/javascript/lib/jquery-3.7.1.min.js"></script>
  <script src="/javascript/lib/sweetalert2@11.js"></script>
  <script type="module" src="/javascript/admin/candidate_manage.js" defer></script>
</head>

<body class="w-[100vw] m-0 bg-blue-600 dvh flex">

  <%- include("../partials/sidebar.ejs") %>

  <main class="relative flex flex-col w-full m-auto overflow-hidden lg:w-4/5 h-dvh lg:px-5">

    <div class="flex items-center w-full h-20 py-3 m-0 lg:pt-7">
      <img id="show-sidebar" src="/img/menu.png" alt="menu" class="w-6 h-6 m-3 ml-5 lg:hidden ">
      <h1 class="relative m-auto font-sans text-2xl font-bold text-white -translate-x-4 justify-items-center lg:text-3xl">Manage Candidate</h1>
    </div>

    <div class="h-full mt-3 mb-3 rounded-lg bg-blue-50 lg:w-full">
      <div class="flex items-center gap-4 px-5 py-1 overflow-x-auto lg:px-7 lg:gap-7 flex-nowrap text-nowrap lg:min-h-16">
        <% positions.forEach(position => { %>
        <div id="position" class="font-semibold text-gray-400"><%= position %></div>
        <% }) %>
      </div>

      <div id="election-box" class="grid gap-6 pt-5 lg:px-7">
        <% if (elections.length < 1) { %>

        <!-- Display no election history -->
        <section class="lg:w-[700px] shadow-md lg:px-10 box-border w-[95%] bg-white rounded-md min-h-28 grid m-auto mt-5 lg:mt-6 py-5 lg:py-9">
          <img src="/img/empty-folder.png" alt="empty folder" class="m-auto w-28 h-28">
          <h1 class="m-auto mt-5 text-lg font-semibold text-center lg:w-3/5">There are no elections scheduled at the moment</h1>
        </section>

        <% } else { %>

        <% elections.forEach(election => { %>
        <section id="election" class="relative w-full transition-colors bg-blue-100 rounded-lg shadow min-h-16">
          <div class="lg:px-8 lg:py-5">
            <h2 class="text-xl font-semibold"><%= election.election_name %></h2>
            <p id="election-id" class="text-gray-400"><%= election.election_id %></p>
            <!-- <img src="/img/chevron.webp" alt="chevron" class="absolute w-5 opacity-70 bottom-3 right-5"> -->
          </div>

          <div id="candidates-display" class="hidden p-1 pb-0 rounded-lg rounded-bl-lg rounded-br-lg">

            <hr class="mb-2 border-t border-gray-300">

            <table class="w-full min-w-[700px]">
              <thead class="">
                <tr class="py-4">
                  <th class="w-32 px-2 py-2 text-base font-medium ">ID</th>
                  <th class="py-2 text-base font-medium">Name</th>
                  <th class="py-2 text-base font-medium ">Alias</th>
                  <th class="py-2 text-base font-medium w-36">Course</th>
                  <th class="py-2 text-base font-medium w-44">Created At</th>
                  <th class="py-2 text-base font-medium ">Status</th>
                  <th class="w-36"></th>
                </tr>
              </thead>

              <tbody id="candidates-section" data-election-id="<%= election.election_id %>">

              </tbody>

            </table>

          </div>
        </section>
        <% }) %>
        <% } %>
      </div>

    </div>

  </main>

</body>

</html>