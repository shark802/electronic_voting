<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Manage Candidate</title>
  <link rel="stylesheet" href="/css/style.css">
  <script src="/javascript/lib/jquery-3.7.1.min.js"></script>
  <script src="/javascript/lib/sweetalert2@11.js"></script>
  <script type="module" src="/javascript/admin/candidate_manage.js" defer></script>
</head>

<body class="w-[100vw] m-0 bg-blue-600 dvh flex overflow-hidden">

  <%- include("../partials/sidebar.ejs") %>

  <main class="relative flex flex-col w-full m-auto overflow-y-auto lg:w-4/5 no-scrollbar h-dvh lg:px-5">

    <div class="flex items-center w-full h-20 py-3 m-0 lg:pt-7">
      <img id="show-sidebar" src="/img/menu.png" alt="menu" class="w-6 h-6 m-3 ml-5 lg:hidden ">
      <h1 class="relative m-auto font-sans text-2xl font-bold text-white -translate-x-4 justify-items-center lg:text-3xl">Manage Candidate</h1>
    </div>

    <div class="relative h-full mt-3 overflow-hidden overflow-x-hidden overflow-y-auto rounded-lg lg:mb-3 bg-blue-50 no-scrollbar">
      <div class="flex items-center w-full gap-5 px-5 py-1 overflow-x-auto bg-blue-50 min-h-14 lg:px-7 lg:gap-7 flex-nowrap text-nowrap lg:min-h-16">
        <% positions.forEach(position => { %>
        <div id="position" class="py-1 font-semibold text-gray-400"><%= position %></div>
        <% }) %>
      </div>

      <div id="election-box" class="grid gap-6 px-3 lg:px-7">
        <% if (elections.length < 1) { %>

        <!-- Display no election -->
        <section class="lg:w-[700px] shadow-md lg:px-10 box-border w-[95%] bg-white rounded-md min-h-28 grid m-auto mt-5 lg:mt-6 py-5 lg:py-9">
          <img src="/img/empty-folder.png" alt="empty folder" class="m-auto w-28 h-28">
          <h1 class="m-auto mt-5 text-lg font-semibold text-center lg:w-3/5">There are no elections scheduled at the moment</h1>
        </section>

        <% } else { %>

        <% elections.forEach(election => { %>
        <section id="election" class="relative w-full transition-colors bg-blue-100 rounded-lg shadow min-h-16">
          <div class="px-8 py-5">
            <h2 class="text-xl font-semibold"><%= election.election_name %></h2>
            <p id="election-id" class="text-gray-400"><%= election.election_id %></p>
            <!-- <img src="/img/chevron.webp" alt="chevron" class="absolute w-5 opacity-70 bottom-3 right-5"> -->
          </div>

          <div id="candidates-display" class="hidden p-1 pb-0 rounded-lg rounded-bl-lg rounded-br-lg">

            <hr class="mb-2 border-t border-gray-300">

            <table class="w-full min-w-[700px]">
              <thead class="">
                <tr class="py-4">
                  <th class="w-32 px-2 py-2 text-base font-medium ">ID</th>
                  <th class="py-2 text-base font-medium">Name</th>
                  <th class="py-2 text-base font-medium ">Alias</th>
                  <th class="py-2 text-base font-medium w-36">Course</th>
                  <th class="py-2 text-base font-medium w-44">Created At</th>
                  <th class="py-2 text-base font-medium ">Status</th>
                  <th class="w-36"></th>
                </tr>
              </thead>

              <tbody id="candidates-section" data-election-id="<%= election.election_id %>">

              </tbody>

            </table>

          </div>
        </section>
        <% }) %>
        <% } %>
      </div>

    </div>

  </main>

  <!-- Edit candidate Modal -->
  <dialog class="rounded-lg">
    <form id="editCandidateForm" class="lg:min-w-[500px] lg: px-7 py-5 rounded-lg shadow-lg">

      <div id="fullname" class="my-1 text-sm text-gray-600">Name: </div>
      <div id="id-number" class="my-1 text-sm text-gray-600">ID: </div>
      <div id="course" class="my-1 text-sm text-gray-600">Course: </div>

      <br>

      <label class="text-sm text-gray-500" for="position">Position</label>
      <select id="selectPosition" class="w-full py-1 pl-3 border border-gray-400 rounded-lg focus:outline-blue-500">
        <option value="">--</option>
        <% positions.forEach((value) => { %>
        <option value="<%= value %>" class="text-sm"> <%= value %> </option>
        <% }) %>
      </select>
      <div id="positionErrorMessage" class="text-sm text-red-500 min-h-5"></div>

      <label class="text-sm text-gray-500" for="alias">Alias</label>
      <input id="alias" type="text" class="w-full py-1 pl-3 border border-gray-400 rounded-lg focus:outline-blue-500">
      <div id="aliasErrorMessage" class="text-sm text-red-500 min-h-5"></div>

      <label class="text-sm text-gray-500" for="party">Party</label>
      <input id="party" type="text" class="w-full py-1 pl-3 border border-gray-400 rounded-lg focus:outline-blue-500">
      <div id="partyErrorMessage" class="text-sm text-red-500 min-h-5"></div>

      <div class="flex justify-end gap-2">
        <button id="closeModal" formmethod="dialog" type="button" class="px-3 py-1 mb-4 font-bold text-white bg-red-500 rounded-lg w-fit">CANCEL</button>
        <input type="submit" value="SAVE" class="px-3 py-1 mb-4 font-bold text-white bg-blue-500 rounded-lg">
      </div>

    </form>
  </dialog>

</body>

</html>