<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Election Tally</title>
  <link rel="stylesheet" href="/css/style.css">
  <script src="/javascript/lib/jquery-3.7.1.min.js"></script>
  <script src="/javascript/lib/sweetalert2@11.js"></script>
  <script src="/javascript/lib/chart.umd.min.js"></script>
  <script type="module" src="/javascript/admin/dashboard_vote_tally.js" defer></script>

</head>

<body class="w-[100vw] m-0 bg-blue-600 dvh flex overflow-hidden">

  <%- include("../partials/sidebar.ejs") %>

  <main class="relative flex flex-col w-full m-auto overflow-y-auto lg:w-4/5 no-scrollbar h-dvh lg:px-5">

    <div class="flex items-center w-full py-3 m-0 lg:h-20 lg:pt-7">
      <img id="show-sidebar" src="/img/menu.webp" alt="menu" class="w-6 h-6 m-3 ml-5 lg:hidden ">
      <h1 class="relative m-auto font-sans text-2xl font-bold text-white -translate-x-4 justify-items-center lg:text-3xl">Election Tally</h1>
    </div>

    <div id="vote-tally-container" class="relative h-screen p-2 mt-3 overflow-hidden overflow-x-hidden overflow-y-auto rounded-lg lg:gap-3 lg:p-5 lg:mb-3 bg-blue-50">

      <% if (elections && elections.length < 1) { %>

      <section class="lg:w-[700px] border-2 border-gray-300 lg:px-10 box-border shadow-sm bg-white rounded-md min-h-28 grid m-auto py-6 mt-7">
        <img src="/img/empty-folder.webp" alt="empty folder" class="m-auto w-28 h-28">
        <h1 class="m-auto mt-3 text-lg font-semibold text-center lg:w-3/5">It seems there are no active election at the moment</h1>

        <a href="/admin/election/new" class="m-auto">
          <button class="px-2 py-1 m-auto mt-5 text-white bg-blue-500 rounded-md w-fit">Create Election?</button>
        </a>
      </section>

      <% 
      } else { 
        
        elections.forEach(election => {
      %>

      <section data-election-id="<%= election.election_id %>" class="pb-3 max-w-[1300px] w-full rounded-md m-auto mb-5 bg-gray-100 border-2 border-gray-300">

        <input id="date-end" type="hidden" value="<%= election.date_end %>">
        <input id="time-end" type="hidden" value="<%= election.time_end %>">

        <div class="flex justify-between p-3 text-white bg-blue-600 rounded-sm shadow-md lg:px-4">
          <div>
            <h2 class="text-lg font-semibold lg:text-2xl"> <%= election.election_name %> </h2>
            <p id="election-id" class="text-sm text-blue-100"> <%= election.election_id %> </p>
          </div>
        </div>

        <div class="flex lg:flex-row grow lg:justify-evenly lg:flex-wrap lg:grow flex-col w-full md:w-[90%] lg:w-full m-auto px-1 py-4 mt-2 lg:px-1">
          <% 
          candidatePosition.forEach(position => {
            
            const candidatesPerPosition = candidates.filter(candidate => candidate.position === position && candidate.election_id === election.election_id );
            if (candidatesPerPosition.length > 0 ) {

              if ( position === 'SENATOR') {
          %>

          <div data-position="<%= position %>" id="position-container" class="border-2 rounded-md bg-gray-50 lg:w-full lg:mx-3">
            <div class="py-2 pl-2 text-lg font-bold text-black rounded-t-md"> <%= position %> </div>
            <div class="flex flex-col w-full px-1 py-2 lg:px-3 justify-evenly lg:flex-row lg:flex-wrap">
              <%
                programs.forEach(program => {
                  const senatorCandidatesPerProgram = candidates.filter(candidate => candidate.position === 'SENATOR' && candidate.election_id === election.election_id );
                  if (senatorCandidatesPerProgram.length > 0) {

                    
            %>

              <div id="senator-by-program" class="mb-2 border bg-gray-100 rounded-md shadow-md lg:w-[49%]">
                <div class="py-2 pl-2 font-bold text-black bg-white rounded-t-md"> <%= program %> </div>
                <canvas id="<%= program %>" class="lg:min-h-[280px] bg-white"></canvas>
              </div>

              <%
                  }
                })
            %>

            </div>

            <%
              } else {
          %>

            <div data-position="<%= position %>" id="position-container" class="mb-4 border bg-gray-100 rounded-md shadow-md lg:m-0 lg:w-[49%] lg:mb-2">
              <div class="py-2 pl-2 text-lg font-bold text-black bg-white rounded-t-md"> <%= position %> </div>
              <canvas id="<%= position %>" class="lg:min-h-[280px] bg-white"></canvas>
            </div>

            <%
              }
            }
          })  
          %>
          </div>
        </div>

      </section>

      <%
    })  
  } 
  %>

    </div>

  </main>

</body>

</html>