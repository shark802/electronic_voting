<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>New Election</title>

  <link rel="stylesheet" href="/css/style.css">
  <script src="/javascript/lib/jquery-3.7.1.min.js"></script>
  <script src="/javascript/lib/sweetalert2@11.js"></script>
  <script type="module" src="/javascript/admin/election_create.js" defer></script>

</head>

<body class="w-[100vw] m-0 bg-blue-600 dvh flex overflow-hidden">

  <%- include("../partials/sidebar.ejs") %>

  <main class="relative flex flex-col w-full m-auto overflow-y-auto lg:w-4/5 no-scrollbar h-dvh lg:px-5">

    <div class="flex items-center w-full h-20 py-3 m-0 lg:pt-7">
      <img id="show-sidebar" src="/img/menu.webp" alt="menu" class="w-6 h-6 m-3 ml-5 lg:hidden ">
      <h1 class="relative m-auto font-sans text-2xl font-bold text-white -translate-x-4 justify-items-center lg:text-3xl">Create New Election</h1>
    </div>

    <div class="relative h-full mt-3 overflow-hidden overflow-x-hidden overflow-y-auto rounded-lg lg:mb-3 bg-blue-50 no-scrollbar">

      <div class="self-center lg:mt-16 mt-10 m-auto bg-white rounded-xl lg:w-[700px] min-h-96 max-w-4/5 w-[90%] max-h-3/5 shadow-sm border border-gray-300">

        <form id="create_election_form" class="px-4 py-5 lg:px-24 lg:py-16">

          <label for="election_name" class="text-sm">Election Name</label>
          <input id="election_name" type="text" class="w-full py-1 pl-4 mt-1 border border-gray-400 border-solid rounded-md focus:outline-blue-500">
          <div id="election_name_error_message" class="text-sm text-red-500 lg:mb-3 h-7"></div>

          <h3 class="text-lg font-semibold text-center lg:text-left">Start</h3>

          <div class="w-full gap-4 lg:flex">
            <div class="w-full lg:w-1/2">
              <label for="election_name" class="text-sm">Date</label><br>
              <input id="date_start" type="date" class="w-full py-1 pl-4 mt-1 border border-gray-400 border-solid rounded-md focus:outline-blue-500">
              <div id="startdate_error_message" class="h-5 text-sm text-red-500"></div>
            </div>

            <div class="w-full lg:w-1/2">
              <label for="election_name" class="text-sm">Time</label><br>
              <input id="time_start" type="time" class="w-full py-1 pl-4 mt-1 border border-gray-400 border-solid rounded-md focus:outline-blue-500">
              <div id="starttime_error_message" class="h-5 text-sm text-red-500"></div>
            </div>

          </div>

          <h3 class="m-auto text-lg font-semibold text-center lg:text-left">End</h3>

          <div class="gap-4 mb-4 lg:flex">
            <div class="w-full lg:w-1/2">
              <label for="election_name" class="text-sm">Date</label><br>
              <input id="date_end" type="date" class="w-full py-1 pl-4 mt-1 border border-gray-400 border-solid rounded-md focus:outline-blue-500">
              <div id="enddate_error_message" class="h-5 text-sm text-red-500"></div>
            </div>

            <div class="w-full lg:w-1/2">
              <label for="election_name" class="text-sm">Time</label><br>
              <input id="time_end" type="time" class="w-full py-1 pl-4 mt-1 border border-gray-400 border-solid rounded-md focus:outline-blue-500">
              <div id="endtime_error_message" class="h-5 text-sm text-red-500"></div>
            </div>

          </div>

          <input type="submit" value="SAVE" class="float-right px-3 py-1 mb-4 font-bold text-white bg-blue-500 rounded-lg ">

        </form>

      </div>
    </div>
  </main>

</body>

</html>