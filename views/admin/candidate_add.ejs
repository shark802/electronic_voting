<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Add Candidate</title>
  <link rel="stylesheet" href="/css/style.css">
  <script src="/javascript/lib/jquery-3.7.1.min.js"></script>
  <script src="/javascript/lib/sweetalert2@11.js"></script>
  <script type="module" src="/javascript/admin/candidate_add.js" defer></script>
</head>

<body class="w-[100vw] m-0 bg-blue-600 dvh flex">

  <%- include("../partials/sidebar.ejs") %>

  <main class="relative flex flex-col w-full m-auto overflow-y-auto lg:px-5 lg:w-4/5 h-dvh">

    <div class="flex items-center w-full h-20 py-3 m-0 lg:pt-7">
      <img id="show-sidebar" src="/img/menu.png" alt="menu" class="w-6 h-6 m-3 ml-5 lg:hidden ">
      <h1 class="relative m-auto font-sans text-2xl font-bold text-white -translate-x-4 justify-items-center lg:text-3xl">Add New Candidate</h1>
    </div>

    <div class="h-full mt-3 mb-3 overflow-y-auto rounded-lg bg-blue-50 lg:w-full no-scrollbar">

      <form id="candidate-form" class="flex lg:pb-0 lg:justify-center lg:py-5 flex-col mb-7 lg:min-h-fit rounded-lg pt-3 lg:w-[800px] w-full lg:px-11 px-4 pb-16 m-auto mt-7 min-h-96 no-scrollbar lg:pt-2">

        <label class="text-sm text-gray-700" for="election">Election *</label>
        <select id="election" class="py-1 pl-2 border border-gray-400 rounded-sm focus:outline-blue-500">
          <option value="">--</option>
          <% electionList.forEach(election => { %>
          <option value="<%= election.election_id %>"><%= election.election_name %></option>
          <% }) %>
        </select>
        <div id="electionErrorMessage" class="text-sm text-red-500 min-h-5"></div>

        <label class="text-sm text-gray-700" for="id-number">Id number *</label>
        <input id="id-number" type="text" class="py-1 pl-3 border border-gray-400 rounded-sm focus:outline-blue-500">
        <div id="idNumberErrorMessage" class="text-sm text-red-500 min-h-5"></div>

        <div class="gap-6 lg:flex">

          <div class="flex flex-col lg:w-1/2">
            <label class="text-sm text-gray-700" for="firstname">Firstname *</label>
            <input id="firstname" type="text" class="py-1 pl-3 border border-gray-400 rounded-sm focus:outline-blue-500">
            <div id="firstnameErrorMessage" class="text-sm text-red-500 min-h-5"></div>
          </div>

          <div class="flex flex-col lg:w-1/2">
            <label class="text-sm text-gray-700" for="lastname">Lastname *</label>
            <input id="lastname" type="text" class="py-1 pl-3 border border-gray-400 rounded-sm focus:outline-blue-500">
            <div id="lastnameErrorMessage" class="text-sm text-red-500 min-h-5"></div>
          </div>

        </div>

        <label class="text-sm text-gray-700" for="program">Program *</label>
        <select id="program" class="py-1 pl-3 border border-gray-400 rounded-sm focus:outline-blue-500">
          <option value="">--</option>
          <% programs.forEach((value) => { %>
          <option value="<%= value %>"> <%= value%> </option>
          <% }) %>
        </select>
        <div id="programErrorMessage" class="text-sm text-red-500 min-h-5"></div>

        <br>

        <label class="text-sm text-gray-700" for="alias">Alias *</label>
        <input id="alias" type="text" class="py-1 pl-3 border border-gray-400 rounded-sm focus:outline-blue-500">
        <div id="aliasErrorMessage" class="text-sm text-red-500 min-h-5"></div>

        <label class="text-sm text-gray-700" for="party">Party *</label>
        <input id="party" type="text" class="py-1 pl-3 border border-gray-400 rounded-sm focus:outline-blue-500">
        <div id="partyErrorMessage" class="text-sm text-red-500 min-h-5"></div>

        <label class="text-sm text-gray-700" for="position">Position *</label>
        <select id="position" class="py-1 pl-3 border border-gray-400 rounded-sm focus:outline-blue-500">
          <option value="">--</option>
          <% positions.forEach((value) => { %>
          <option value="<%= value %>"> <%= value %> </option>
          <% }) %>
        </select>
        <div id="positionErrorMessage" class="text-sm text-red-500 min-h-5"></div>


        <button type="submit" class="w-full px-5 py-1 m-auto text-lg font-semibold text-white bg-green-500 rounded-sm ring-green-400 lg:mb-0 hover:ring-2 ">Save</button>
      </form>
    </div>

  </main>

</body>

</html>