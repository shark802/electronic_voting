<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Add Candidate</title>
  <link rel="stylesheet" href="/css/style.css">
  <script src="/javascript/lib/jquery-3.7.1.min.js"></script>
  <script src="/javascript/lib/sweetalert2@11.js"></script>
  <script type="module" src="/javascript/admin/candidate_add.js" defer></script>
</head>

<body class="w-[100vw] m-0 bg-blue-600 dvh flex">

  <%- include("../partials/sidebar.ejs") %>

  <main class="relative flex flex-col w-full px-3 m-auto overflow-y-auto lg:px-2 lg:w-4/5 h-dvh">

    <div class="flex items-center w-full py-3 m-0 lg:h-20 lg:pt-7">
      <img id="show-sidebar" src="/img/menu.webp" alt="menu" class="w-6 h-6 m-3 ml-2 lg:hidden ">
      <h1 class="relative m-auto font-sans text-2xl font-bold text-white -translate-x-4 justify-items-center lg:text-3xl">Add New Candidate</h1>
    </div>

    <div class="w-full h-full px-3 mt-3 mb-2 overflow-y-auto bg-white rounded-lg no-scrollbar">

      <form id="candidate-form" class="flex lg:pb-0 lg:justify-center flex-col mb-7 lg:min-h-fit rounded-lg lg:w-[800px] w-full lg:px-11 px-4 pb-16 m-auto mt-7 min-h-96 no-scrollbar lg:pt-1">

        <label class="text-sm font-semibold text-gray-500" for="election">Election <span class="text-red-400">*</span></label>
        <select id="election" name="election_id" class="py-2 pl-2 text-sm font-semibold border border-gray-300 rounded-sm lg:text-base focus:outline-blue-500">
          <option value="">--</option>
          <% electionList.forEach(election => { %>
          <option value="<%= election.election_id %>"><%= election.election_name %></option>
          <% }) %>
        </select>
        <div id="electionErrorMessage" class="text-sm font-medium text-red-500 min-h-5"></div>

        <label class="text-sm font-semibold text-gray-500" for="id-number">Id number <span class="text-red-400">*</span></label>
        <input id="id-number" type="number" name="id_number" class="py-2 pl-3 text-sm font-semibold border border-gray-300 rounded-sm lg:text-base focus:outline-blue-500">
        <div id="idNumberErrorMessage" class="text-sm font-medium text-red-500 min-h-5"></div>

        <div class="gap-6 lg:flex">

          <div class="flex flex-col lg:w-1/2">
            <label class="text-sm font-semibold text-gray-500" for="firstname">Firstname <span class="text-red-400">*</span></label>
            <input id="firstname" type="text" name="firstname" class="py-2 pl-3 text-sm font-semibold border border-gray-300 rounded-sm lg:text-base focus:outline-blue-500">
            <div id="firstnameErrorMessage" class="text-sm font-medium text-red-500 min-h-5"></div>
          </div>

          <div class="flex flex-col lg:w-1/2">
            <label class="text-sm font-semibold text-gray-500" for="lastname">Lastname <span class="text-red-400">*</span></label>
            <input id="lastname" type="text" name="lastname" class="py-2 pl-3 text-sm font-semibold border border-gray-300 rounded-sm lg:text-base focus:outline-blue-500">
            <div id="lastnameErrorMessage" class="text-sm font-medium text-red-500 min-h-5"></div>
          </div>

        </div>

        <label class="text-sm font-semibold text-gray-500" for="program">Program <span class="text-red-400">*</span></label>
        <select id="program" name="course" class="py-2 pl-3 text-sm font-semibold border border-gray-300 rounded-sm lg:text-base focus:outline-blue-500">
          <option value="">--</option>
          <% programs.forEach((value) => { %>
          <option value="<%= value %>"> <%= value%> </option>
          <% }) %>
        </select>
        <div id="programErrorMessage" class="text-sm font-medium text-red-500 min-h-5"></div>

        <br>

        <!-- <div class="gap-6 lg:flex"> -->

        <!-- <div class="flex flex-col lg:w-1/2">
            <label class="text-sm font-semibold text-gray-500" for="alias">Alias <span class="text-red-400">*</span></label>
            <input id="alias" name="alias" type="text" class="py-2 pl-3 text-sm font-semibold border border-gray-300 rounded-sm lg:text-base focus:outline-blue-500">
            <div id="aliasErrorMessage" class="text-sm font-medium text-red-500 min-h-5"></div>
          </div> -->

        <label class="text-sm font-semibold text-gray-500" for="party">Party <span class="text-red-400">*</span></label>
        <input id="party" name="party" type="text" class="py-2 pl-3 text-sm font-semibold border border-gray-300 rounded-sm lg:text-base focus:outline-blue-500">
        <div id="partyErrorMessage" class="text-sm font-medium text-red-500 min-h-5"></div>

        <!-- </div> -->

        <label class="text-sm font-semibold text-gray-500" for="position">Position <span class="text-red-400">*</span></label>
        <select id="position" name="position" class="py-2 pl-3 text-sm font-semibold border border-gray-300 rounded-sm lg:text-base focus:outline-blue-500">
          <option value="">--</option>
          <% positions.forEach((value) => { %>
          <option value="<%= value %>"> <%= value %> </option>
          <% }) %>
        </select>
        <div id="positionErrorMessage" class="text-sm font-medium text-red-500 min-h-5"></div>


        <div class="font-[sans-serif] max-w-md py-5">
          <label class="block mb-2 text-base font-semibold text-gray-500">Upload profile</label>
          <input type="file" name="candidate_profile" class="w-full text-sm font-semibold text-gray-400 bg-white border border-gray-300 rounded cursor-pointer file:cursor-pointer file:border-0 file:py-3 file:px-4 file:mr-4 file:bg-gray-100 file:hover:bg-gray-200 file:text-gray-500" />
          <p class="mt-2 text-xs text-gray-400">PNG, JPG and WEBP are Allowed.</p>
        </div>


        <button type="submit" class="text-white bg-blue-700 hover:bg-blue-800 focus:ring-2 focus:outline-none focus:ring-blue-300 font-medium rounded-lg text-sm px-5 py-2.5 text-center">Save</button>
      </form>
    </div>

  </main>

</body>

</html>