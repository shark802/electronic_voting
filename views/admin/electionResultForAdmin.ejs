<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Result</title>

  <link rel="stylesheet" href="/css/style.css">
  <script src="/javascript/lib/jquery-3.7.1.min.js"></script>
  <script src="/javascript/lib/socket.io.min.js" defer></script>
  <script src="/javascript/lib/sweetalert2@11.js" defer></script>
  <script type="module" src="/javascript/voter/electionResultForVoter.js"></script>

  <style>
    dialog::backdrop {
      background-color: rgba(0, 0, 0, 0.4);
    }
  </style>
</head>

<body class="w-full bg-blue-50 lg:px-0 h-dvh">

  <header class="sticky top-0 z-50 w-full shadow-lg bg-gradient-to-r from-blue-900 to-blue-700">
    <!-- Top navigation bar -->
    <div class="flex items-center justify-between w-full px-4 py-3 md:px-6">
      <div class="flex items-center space-x-3">
        <a href="/admin/election/history" class="inline-flex items-center px-3 py-2 text-sm font-medium text-white transition-all duration-200 ease-in-out bg-blue-800 rounded-lg shadow-md hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-opacity-50">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 mr-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          <span class="hidden sm:inline">Back to Election History</span>
          <span class="sm:hidden">Back</span>
        </a>

        <div class="hidden w-px h-6 bg-blue-400 md:block"></div>

        <h1 class="hidden text-lg font-bold text-white md:block">
          <span class="mr-2">Election Results:</span>
          <span class="text-blue-200"><%= electionInfo.election_name %></span>
        </h1>
      </div>

      <div class="flex items-center space-x-2 md:space-x-3">
        <button id="generate-result-pdf" class="flex items-center px-3 py-2 text-sm font-medium text-white transition-colors duration-300 bg-green-600 rounded-md hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-green-500 focus:ring-opacity-50">
          <svg class="w-5 h-5 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path>
          </svg>
          <span class="hidden sm:inline">Generate PDF</span>
          <span class="sm:hidden">PDF</span>
        </button>
      </div>
    </div>

    <!-- Election status bar -->
    <div class="flex items-center justify-between px-4 py-2 bg-blue-800 md:px-6">
      <div class="flex items-center space-x-4">
        <div class="flex items-center text-sm text-blue-200">
          <svg class="w-4 h-4 mr-1.5 text-blue-300" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
          </svg>
          <span><%= formatDateTime(electionInfo.date_start, electionInfo.time_start) %> - <%= formatDateTime(electionInfo.date_end, electionInfo.time_end) %></span>
        </div>

        <div class="items-center hidden text-sm text-blue-200 md:flex">
          <svg class="w-4 h-4 mr-1.5 text-blue-300" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
          </svg>
          <span><%= candidatesVoteTally.length %> Candidates</span>
        </div>

        <div class="items-center hidden text-sm text-blue-200 md:flex">
          <svg class="w-4 h-4 mr-1.5 text-blue-300" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
          </svg>
          <span><%= positionList.length %> Positions</span>
        </div>
      </div>

      <div class="flex items-center">
        <% 
        const now = new Date();
        const startDate = new Date(electionInfo.date_start);
        startDate.setHours(parseInt(electionInfo.time_start.split(':')[0]), parseInt(electionInfo.time_start.split(':')[1]));
        
        const endDate = new Date(electionInfo.date_end);
        endDate.setHours(parseInt(electionInfo.time_end.split(':')[0]), parseInt(electionInfo.time_end.split(':')[1]));
        
        let statusClass = '';
        let statusText = '';
        
        if (now < startDate) {
          statusClass = 'bg-yellow-500';
          statusText = 'Upcoming';
        } else if (now > endDate) {
          statusClass = 'bg-green-500';
          statusText = 'Completed';
        } else {
          statusClass = 'bg-blue-500';
          statusText = 'In Progress';
        }
        %>
      </div>
    </div>
  </header>

  <main class="container max-w-4xl px-4 py-8 mx-auto">
    <!-- Election info card -->
    <div id="result-box" class="w-full mb-10 overflow-hidden bg-white shadow-lg rounded-xl animate-fade-in">
      <div class="p-6 border-b border-blue-100 bg-gradient-to-r from-blue-50 to-white">
        <div class="mb-6 text-center">
          <input type="hidden" id="election-id" value="<%= electionInfo.election_id %>">
          <h2 class="mb-2 text-2xl font-bold text-blue-800 md:text-3xl"><%= electionInfo.election_name %></h2>

          <div class="flex flex-col items-center justify-center mt-4 space-y-3 sm:flex-row sm:space-y-0 sm:space-x-6">
            <div class="flex items-center px-4 py-2 text-sm text-blue-700 rounded-full bg-blue-50">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 mr-2 text-blue-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
              <span class="font-medium">Start:</span>
              <span class="ml-1"><%= formatDateTime(electionInfo.date_start, electionInfo.time_start) %></span>
            </div>

            <div class="flex items-center px-4 py-2 text-sm text-blue-700 rounded-full bg-blue-50">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 mr-2 text-blue-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <span class="font-medium">End:</span>
              <span class="ml-1"><%= formatDateTime(electionInfo.date_end, electionInfo.time_end) %></span>
            </div>
          </div>
        </div>

        <%
        function formatDateTime(date, time) {
          const [hours, minutes] = time.split(':');
          const dateTime = new Date(date);
          dateTime.setHours(parseInt(hours), parseInt(minutes));
          return dateTime.toLocaleString('en-US', { 
            dateStyle: 'medium', 
            timeStyle: 'short' 
          });
        }
        %>
      </div>

      <div class="p-6">
        <% if (positionList && positionList.length > 0) { %>

        <% if (candidatesVoteTally.length < 1) { %>
        <!-- No results state with improved design -->
        <div class="p-8 text-center bg-gray-50 rounded-xl">
          <svg class="w-16 h-16 mx-auto mb-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
          </svg>
          <h2 class="mb-2 text-xl font-semibold text-gray-800">No Results to Display</h2>
          <p class="text-gray-600">There are no candidates or results available for this election at the moment.</p>
        </div>
        <% } else { %>
        <!-- Results by position with improved design -->
        <div class="space-y-8">
          <% 
          positionList.forEach((position, posIndex) => {
            // Special handling for SENATOR position
            if (position === 'SENATOR') {
              // Get all senator candidates
              const senatorCandidates = candidatesVoteTally.filter(candidate => candidate.position === position);
              
              if (senatorCandidates.length > 0) {
                // Get unique departments from senators
                const departments = [...new Set(senatorCandidates.map(candidate => candidate.department))];
          %>
          <!-- SENATOR section header -->
          <section class="overflow-hidden bg-white border border-gray-200 shadow-sm rounded-xl">
            <div class="py-3 text-center text-white bg-blue-600">
              <h3 class="text-lg font-bold">SENATOR</h3>
            </div>

            <!-- Main container for all departments -->
            <div class="p-1 divide-y divide-gray-200 ">
              <% 
            // Group candidates by department first
            const departmentGroups = {};
            
            // Populate department groups
            departments.forEach(department => {
              const candidatesInDept = senatorCandidates.filter(candidate => candidate.department === department);
              
              if (candidatesInDept.length > 0) {
                // Sort candidates by vote count in descending order
                candidatesInDept.sort((a, b) => b.vote_count - a.vote_count);
                
                // Calculate metrics for this department
                const highestVoteInDept = candidatesInDept.reduce((highest, candidate) => 
                  candidate.vote_count > highest ? candidate.vote_count : highest, 0);
                
                const totalVotesInDept = candidatesInDept.reduce((total, candidate) => 
                  total + candidate.vote_count, 0);
                  
                departmentGroups[department] = {
                  candidates: candidatesInDept,
                  highestVote: highestVoteInDept,
                  totalVotes: totalVotesInDept
                };
              }
            });
            
            // render each department group
            Object.keys(departmentGroups).forEach(department => {
              const deptData = departmentGroups[department];
            %>
              <!-- Department section -->
              <div class="mb-1 department-section">

                <!-- Department header -->
                <div class="py-2 pl-3 text-center text-blue-700 bg-blue-200 border-t border-blue-600">
                  <h4 class="font-semibold "><%= department %> Department</h4>
                </div>

                <!-- Candidates in this department -->
                <div class="divide-y divide-gray-100">
                  <% deptData.candidates.forEach(candidate => { 
                              const votePercentage = deptData.totalVotes === 0 ? 0 : ((candidate.vote_count / deptData.totalVotes) * 100).toFixed(2);
                              const isWinning = candidate.vote_count === deptData.highestVote && candidate.vote_count > 0;
                          %>

                  <div class="p-4 transition-colors duration-200 <%= isWinning ? 'bg-green-50' : 'hover:bg-blue-50' %>">
                    <div class="flex items-center justify-between">
                      <div class="flex items-center space-x-4">
                        <div class="relative flex-shrink-0">
                          <% if (candidate.candidate_profile) { %>
                          <img class="object-cover w-14 h-14 rounded-full border-2 <%= isWinning ? 'border-green-500' : 'border-gray-200' %>" src="/img/candidate_profiles/<%= candidate.candidate_profile %>" alt="<%= candidate.firstname %> <%= candidate.lastname %>">
                          <% } else { %>
                          <div class="flex items-center justify-center w-14 h-14 text-lg font-bold text-white <%= isWinning ? 'bg-green-500' : 'bg-blue-400' %> rounded-full">
                            <%= candidate.firstname.charAt(0) %><%= candidate.lastname.charAt(0) %>
                          </div>
                          <% } %>
                          <% if (isWinning) { %>
                          <div class="absolute flex items-center justify-center w-6 h-6 text-white bg-green-500 rounded-full -top-1 -right-1">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                            </svg>
                          </div>
                          <% } %>
                        </div>
                        <div>
                          <p class="text-base font-bold text-gray-800 md:text-lg"><%= candidate.firstname %> <%= candidate.lastname %></p>
                          <p class="text-sm text-gray-500"><%= candidate.course %></p>
                        </div>
                      </div>
                      <div class="text-right">
                        <div class="flex flex-col items-end">
                          <p class="text-xl font-bold <%= isWinning ? 'text-green-600' : 'text-gray-700' %>">
                            <%= votePercentage %>%
                          </p>
                          <p class="text-sm text-gray-500"><%= candidate.vote_count %> votes</p>
                        </div>
                      </div>
                    </div>

                    <!-- Vote percentage bar -->
                    <div class="w-full h-2 mt-3 overflow-hidden bg-gray-100 rounded-full">
                      <div class="h-full <%= isWinning ? 'bg-green-500' : 'bg-blue-500' %> rounded-full" style="width: <%= votePercentage %>%"></div>
                    </div>
                  </div>
                  <% }); %>
                </div>
              </div>
              <% }); %>
            </div>
          </section>

          <% 
              }
            } else {
              // Handle other positions as before
              const candidatePerPosition = candidatesVoteTally.filter(candidate => candidate.position === position);
              
              if (candidatePerPosition.length > 0) {
                candidatePerPosition.sort((a, b) => b.vote_count - a.vote_count);
                const highestVoteInPosition = candidatePerPosition.reduce((highest, currentCandidateIteration) => 
                  currentCandidateIteration.vote_count > highest ? currentCandidateIteration.vote_count : highest, 0);
                const totalVotesInPosition = candidatePerPosition.reduce((total, candidateVotes) => 
                  total + candidateVotes.vote_count, 0);
          %>
          <section class="overflow-hidden bg-white border border-gray-200 shadow-sm result-card rounded-xl" style="animation-delay: <%= (posIndex * 0.1).toFixed(1) %>s">
            <div class="py-3 text-center text-white bg-blue-600">
              <h3 class="text-lg font-bold"><%= position %></h3>
            </div>

            <div class="divide-y divide-gray-100">
              <% candidatePerPosition.forEach((candidate, index) => { 
                    const votePercentage = totalVotesInPosition === 0 ? 0 : ((candidate.vote_count / totalVotesInPosition) * 100).toFixed(2);
                    const isWinning = candidate.vote_count === highestVoteInPosition && candidate.vote_count > 0;
              %>
              <div class="p-4 transition-colors duration-200 <%= isWinning ? 'bg-green-50' : 'hover:bg-blue-50' %>">
                <div class="flex items-center justify-between">
                  <div class="flex items-center space-x-4">
                    <div class="relative flex-shrink-0">
                      <% if (candidate.candidate_profile) { %>
                      <img class="object-cover w-14 h-14 rounded-full border-2 <%= isWinning ? 'border-green-500' : 'border-gray-200' %>" src="/img/candidate_profiles/<%= candidate.candidate_profile %>" alt="<%= candidate.firstname %> <%= candidate.lastname %>">
                      <% } else { %>
                      <div class="flex items-center justify-center w-14 h-14 text-lg font-bold text-white <%= isWinning ? 'bg-green-500' : 'bg-blue-400' %> rounded-full">
                        <%= candidate.firstname.charAt(0) %><%= candidate.lastname.charAt(0) %>
                      </div>
                      <% } %>
                      <% if (isWinning) { %>
                      <div class="absolute flex items-center justify-center w-6 h-6 text-white bg-green-500 rounded-full -top-1 -right-1">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                        </svg>
                      </div>
                      <% } %>
                    </div>
                    <div>
                      <p class="text-base font-bold text-gray-800 md:text-lg"><%= candidate.firstname %> <%= candidate.lastname %></p>
                      <p class="text-sm text-gray-500"><%= candidate.course %></p>
                    </div>
                  </div>
                  <div class="text-right">
                    <div class="flex flex-col items-end">
                      <p class="text-xl font-bold <%= isWinning ? 'text-green-600' : 'text-gray-700' %>">
                        <%= votePercentage %>%
                      </p>
                      <p class="text-sm text-gray-500"><%= candidate.vote_count %> votes</p>
                    </div>
                  </div>
                </div>

                <!-- Vote percentage bar -->
                <div class="w-full h-2 mt-3 overflow-hidden bg-gray-100 rounded-full">
                  <div class="h-full <%= isWinning ? 'bg-green-500' : 'bg-blue-500' %> rounded-full" style="width: <%= votePercentage %>%"></div>
                </div>
              </div>
              <% }); %>
            </div>
          </section>
          <% 
              }
            }
          });
          %>
        </div>
        <% } %>

        <% } else { %>
        <!-- No positions available state -->
        <div class="p-8 text-center border border-yellow-100 bg-yellow-50 rounded-xl">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-16 h-16 mx-auto mb-4 text-yellow-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
          </svg>
          <h2 class="mb-2 text-xl font-semibold text-yellow-800">No Positions Available</h2>
          <p class="text-yellow-700">No positions or results are available for this election.</p>
        </div>
        <% } %>
      </div>
    </div>
  </main>
</body>

</html>