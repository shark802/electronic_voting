<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Result</title>

  <link rel="stylesheet" href="/css/style.css">
  <script src="/javascript/lib/jquery-3.7.1.min.js"></script>
  <script src="/javascript/lib/socket.io.min.js" defer></script>
  <script type="module" src="/javascript/voter/electionResultForVoter.js"></script>

  <style>
    dialog::backdrop {
      background-color: rgba(0, 0, 0, 0.4);
    }
  </style>
</head>

<body class="w-full bg-blue-50 lg:px-0 h-dvh">

  <header class="flex items-center justify-between w-full px-4 py-3 shadow-md bg-gradient-to-r from-blue-800 to-blue-600">

    <a href="/admin/election/history" class="inline-flex items-center px-4 py-2 text-white transition-all duration-200 ease-in-out bg-blue-600 rounded-lg shadow-md hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-opacity-50">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
      </svg>
      <span class="font-medium">Back to Election History</span>
    </a>
  </header>

  <div class="relative px-4 mt-24 overflow-y-auto bg-blue-50">
    <div id="result-box" class="w-full lg:max-w-[750px] rounded-lg px-4 py-6 m-auto bg-white shadow-lg mb-10">

      <h2 class="mb-2 text-3xl font-bold leading-tight text-center text-blue-800"><%= electionInfo.election_name %></h2>
      <p class="mb-4 text-lg text-center text-gray-600">Election Results</p>
      <div class="flex flex-col items-center justify-center mb-4 space-y-2 sm:flex-row sm:space-y-0 sm:space-x-4">
        <div class="flex items-center text-sm text-gray-500">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 mr-1 text-blue-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
          <span class="font-medium">Start:</span>
          <%= formatDateTime(electionInfo.date_start, electionInfo.time_start) %>
        </div>
        <div class="flex items-center text-sm text-gray-500">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 mr-1 text-blue-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span class="font-medium">End:</span>
          <%= formatDateTime(electionInfo.date_end, electionInfo.time_end) %>
        </div>
      </div>

      <%
        function formatDateTime(date, time) {
          const [hours, minutes] = time.split(':');
          const dateTime = new Date(date);
          dateTime.setHours(parseInt(hours), parseInt(minutes));
          return dateTime.toLocaleString('en-US', { 
            dateStyle: 'medium', 
            timeStyle: 'short' 
          });
        }
        %>

      <% if (positionList && positionList.length > 0) { %>
      <% if (candidatesVoteTally.length < 1) { %>
      <!-- No Results Message -->
      <div class="max-w-md mx-auto overflow-hidden bg-white rounded-lg shadow-sm">
        <div class="flex items-center p-6 space-x-4">
          <div class="flex-shrink-0">
            <svg class="w-12 h-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
            </svg>
          </div>
          <div>
            <h2 class="text-lg font-semibold text-gray-800">No Results to Display</h2>
            <p class="mt-1 text-sm text-gray-600">There are no candidates or results available for this election at the moment.</p>
          </div>
        </div>
      </div>
      <% } else { %>

      <!-- Loop through positions -->
      <% positionList.forEach(position => { 
            let candidatePerPosition = candidatesVoteTally.filter(candidate => candidate.position === position);
            if (candidatePerPosition.length > 0) {
              candidatePerPosition.sort((a, b) => b.vote_count - a.vote_count);
              const totalVotesInPosition = candidatePerPosition.reduce((total, candidateVotes) => total + candidateVotes.vote_count, 0);
      %>

      <% if (position === 'SENATOR') { %>
      <!-- Loop through departments for SENATOR -->

      <% departments.forEach(department => { %>
      <% const senatorCandidatePerDepartment = candidatePerPosition.filter(candidate => candidate.department === department) %>

      <% if (senatorCandidatePerDepartment.length > 0) { %>

      <% const highestVoteCountSenatorPerDepartment = senatorCandidatePerDepartment.reduce((highest, currentSenatorCandidate) => currentSenatorCandidate.vote_count > highest ? currentSenatorCandidate.vote_count : highest, 0); %>

      <section class="mb-8 overflow-hidden border border-gray-200 rounded-lg">
        <h3 class="w-full py-2 text-lg font-bold text-center text-white bg-blue-600"><%= department %> <%= position %></h3>

        <div class="divide-y divide-gray-200"></div>
        <% senatorCandidatePerDepartment.sort((a, b) => b.vote_count - a.vote_count ).forEach((candidate, index) => { %>

        <div class="flex items-center justify-between p-4 <%= candidate.vote_count === highestVoteCountSenatorPerDepartment ? 'bg-green-50' : 'hover:bg-gray-50' %> transition duration-150 ease-in-out">
          <div class="flex items-center space-x-4">
            <div class="flex-shrink-0">
              <% if (candidate.candidate_profile) { %>
              <img class="object-cover w-12 h-12 rounded-full" src="/img/candidate_profiles/<%= candidate.candidate_profile %>" alt="<%= candidate.firstname %> <%= candidate.lastname %>">
              <% } else { %>
              <div class="flex items-center justify-center w-12 h-12 font-bold text-gray-600 bg-gray-300 rounded-full">
                <%= candidate.firstname.charAt(0) %><%= candidate.lastname.charAt(0) %>
              </div>
              <% } %>
            </div>
            <div>
              <p class="font-bold text-gray-800"><%= candidate.firstname %> <%= candidate.lastname %></p>
              <p class="text-sm text-gray-500"><%= candidate.course %></p>
            </div>
          </div>

          <div class="text-right">
            <p class="text-2xl font-bold <%= candidate.vote_count === highestVoteCountSenatorPerDepartment ? 'text-green-600' : 'text-gray-600' %>">
              <%= totalVotesInPosition === 0 ? '0%' : ((candidate.vote_count / totalVotesInPosition) * 100).toFixed(2) + '%' %>
            </p>
            <p class="text-sm text-gray-500"><%= candidate.vote_count %> votes</p>
          </div>

        </div>

        <% }); %>
        <% } %>
      </section>

      <% }); %>

      <% } else { %>

      <!-- Other positions -->

      <% if(candidatePerPosition.length > 0) { %>

      <% const highestVoteCount = candidatePerPosition.reduce((highest, currentCandidate) => currentCandidate.vote_count > highest ? currentCandidate.vote_count : highest, 0); %>

      <section class="mb-8 overflow-hidden border border-gray-200 rounded-lg">
        <h3 class="w-full py-2 text-lg font-bold text-center text-white bg-blue-600"><%= position %></h3>

        <div class="divide-y divide-gray-200">

          <% candidatePerPosition.sort((a, b) => b.vote_count - a.vote_count).forEach(candidate => { %>

          <div class="flex items-center justify-between p-4 transition duration-150 ease-in-out <%= candidate.vote_count === highestVoteCount ? 'bg-green-50' : 'hover:bg-gray-50' %> ">
            <div class="flex items-center space-x-4 ">
              <div class="flex-shrink-0">
                <% if (candidate.candidate_profile) { %>
                <img class="object-cover w-12 h-12 rounded-full" src="/img/candidate_profiles/<%= candidate.candidate_profile %>" alt="<%= candidate.firstname %> <%= candidate.lastname %>">
                <% } else { %>
                <div class="flex items-center justify-center w-12 h-12 font-bold text-gray-600 bg-gray-300 rounded-full">
                  <%= candidate.firstname.charAt(0) %><%= candidate.lastname.charAt(0) %>
                </div>
                <% } %>
              </div>
              <div>
                <p class="font-bold text-gray-800"><%= candidate.firstname %> <%= candidate.lastname %></p>
                <p class="text-sm text-left text-gray-500"><%= candidate.course %></p>
              </div>
            </div>
            <div class="text-right">
              <p class="text-2xl font-bold <%= candidate.vote_count === highestVoteCount ? 'text-green-600' : 'text-gray-600' %>">
                <%= totalVotesInPosition === 0 ? '0%' : ((candidate.vote_count / totalVotesInPosition) * 100).toFixed(2) + '%' %>
              </p>
              <p class="text-sm text-gray-500"><%= candidate.vote_count %> votes</p>
            </div>
          </div>

          <% }) %>

        </div>
      </section>

      <% } %>
      <% } %>
      <% } }); %>

      <% } %>
      <% } %>

    </div>
  </div>
</body>

</html>